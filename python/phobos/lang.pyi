def rowmean(t) -> Any:
    """The mean of each row, `[R, C] -> [R, 1]`. `t` may be an elementwise
    expression, as in `rowmean(x * x)`."""


def rowmin(t) -> Any:
    """The minimum of each row, `[R, C] -> [R, 1]`."""


def rowargmin(t) -> Any:
    """The column of each row's minimum, `[R, C] -> [R, 1]` (`i32`), the
    smaller column on a tie."""


def rowvar(t) -> Any:
    """The variance of each row, `[R, C] -> [R, 1]`: the mean squared distance
    from the row's mean, the biased variance a layer norm takes."""


def colsum(t) -> Any:
    """Reductions down the columns, `[R, C] -> [1, C]`, as a batch norm folds
    a batch. Each transposes `t` through shared memory and reduces its rows."""


def colmax(t) -> Any:
    ...


def colmin(t) -> Any:
    ...


def colmean(t) -> Any:
    ...


def softmax(t) -> Any:
    """Each row's softmax, in place: `e^(t - max) / sum e^(t - max)`. The row
    maximum is taken out first, so no row overflows."""


def log_softmax(t) -> Any:
    """Each row's log-softmax, in place: `t - logsumexp(t)`."""


def logsumexp(out, t) -> Any:
    """`out` (`[R, 1]`) is `log sum_j e^t[i, j]` of each row, computed around
    the row maximum."""


def mask_cols(t, n, fill) -> Any:
    """Sets every column at or past `n` to `fill`, in place: the mask a ragged
    last tile needs before a reduction that a zero would change. A slice past
    the end of a tensor reads as 0, so a softmax over one is masked with
    `mask_cols(s, n, -1.0e30)`."""


def causal_mask(t, q0, k0) -> Any:
    """The causal mask of attention scores, in place: element `[i, j]` is query
    `q0 + i` against key `k0 + j`, and a key after its query is set to
    `-1.0e30`, so a softmax gives it no weight."""


def topk(values, indices, t) -> Any:
    """The `K` largest values of each row of `t` into `values` (`[R, K]`) and
    their columns into `indices` (`[R, K]`, `i32`), largest first, the
    smaller column on a tie. `t` is consumed: each pick is overwritten with
    `-1.0e30`. `values` and `indices` must be names."""


def rms_norm(x, w, eps) -> Any:
    """Root-mean-square norm: `x / sqrt(mean(x^2) + eps) * w`, LLaMA's."""


def layer_norm(x, w, b, eps) -> Any:
    """Layer norm: `(x - mean(x)) / sqrt(var(x) + eps) * w + b`, the biased
    variance, as `torch.nn.functional.layer_norm`."""


def batch_norm(x, mean, variance, w, b, eps) -> Any:
    """Batch norm as inference applies it: `(x - mean) / sqrt(variance + eps)
    * w + b`, with `mean`, `variance`, `w` and `b` the running statistics and
    the affine parameters, each a `[1, C]` row or a scalar. An expression
    function, so it fuses into the statement that stores it."""


def batch_norm_stats(mean, variance, x) -> Any:
    """The batch statistics of the rows of `x`, a batch of `R` samples: each
    column's mean into `mean` and its biased variance into `variance`, both
    `[1, C]` names. The statistics of a batch spread over several blocks are
    the merge of each block's."""


def l2_normalize(x, eps) -> Any:
    """Each row scaled to unit length: `x / max(||x||, eps)`, as
    `torch.nn.functional.normalize`."""


def online_softmax(acc, m, l, s, v) -> Any:
    """One block of keys' step of the online softmax, Flash attention's inner
    update. `s` (`[BR, BC]`) holds this block's scaled scores, masked where
    needed, and is overwritten with their unnormalized probabilities. The
    running state is the row maximum `m` and the denominator `l`, both
    `[BR, 1]`, and the unnormalized output `acc` (`[BR, D]`), which gains
    the block's values `v` (`[BC, D]`) weighted by `s`. Start with `m` at
    `-1.0e30`, `l` and `acc` at 0, and divide `acc` by `l` after the last
    block."""


def attention(acc, q, K, V, scale, BR, BC) -> Any:
    """Attention of the queries `q` (`[BR, D]`) over every key of `K` and value
    of `V` (both `[Nk, D]` tensors), `BC` keys a step: `acc` (`[BR, D]`, `f32`)
    becomes `softmax(q K^T * scale) V`. `acc` must start at 0, as a
    declaration `var acc: tile<f32>[BR, D] = 0.0` leaves it, which keeps it in
    the tensor cores' registers under `@tensorcore`. A last block of keys
    past `Nk` is masked."""


def rope(x, cos, sin) -> Any:
    """Rotary position embedding, in place, in the rotate-half form of GPT-NeoX
    and Hugging Face's LLaMA: each row of `x` (`[R, D]`) is split into halves
    `a` and `b`, and becomes `[a cos - b sin, b cos + a sin]`. `cos` and
    `sin` are `[R, D / 2]`, the angles of each row's position. GPT-J's form,
    which rotates adjacent pairs, is `rope_pairs`."""


def rope_pairs(x0, x1, cos, sin) -> Any:
    """Rotary position embedding of the pairs `(x0, x1)`, in place: `x0` becomes
    `x0 cos - x1 sin` and `x1` becomes `x1 cos + x0 sin`, all four the same
    shape. GPT-J's interleaved pairs are two names when the kernel declares
    the heads as `[T, D / 2, 2]`: `x0` is `X[t :+ R, :, 0]` and `x1` is
    `X[t :+ R, :, 1]`, with `cos` and `sin` declared `[T, D / 2, 1]` and
    sliced the same way."""


def matmul(acc, A, B, m0, n0, BK) -> Any:
    """`acc += A[m0 :+ BM, :] B[:, n0 :+ BN]`, `BK` columns of `A` a step.
    `A` is `[M, K]`, `B` is `[K, N]` and `acc` is `[BM, BN]`."""


def matmul_t(acc, A, B, m0, n0, BK) -> Any:
    """`acc += A[m0 :+ BM, :] B[n0 :+ BN, :]^T`, against a `B` stored `[N, K]`,
    as a linear layer's weight is: `matmul_t(acc, X, W, m0, n0, BK)` is
    `torch.nn.functional.linear` without the bias."""


def quantize_i8(q, s, x) -> Any:
    """Each row of `x` (`[R, C]`) as `i8` in `q` (`[R, C]`) and its scale in `s`
    (`[R, 1]`, `f32`), so `x` is about `q * s`: the row's largest magnitude
    maps to 127. `q` and `s` may be tiles or tensor slices."""


def dequantize_i8(x, q, s) -> Any:
    """`x = q * s`, the inverse of `quantize_i8`."""


def cross_entropy(out, t, target) -> Any:
    """Cross-entropy of the logits `t` (`[R, C]`) against the class of each row,
    `target` (`[R, 1]`, `i32`): `logsumexp(t) - t[target]`, into `out`
    (`[R, 1]`). `t` is left unchanged."""


def nll_loss(logp, target) -> Any:
    """The negative log-likelihood of each row's class `target` (`[R, 1]`,
    `i32`) under the log-probabilities `logp`, as `log_softmax` leaves them:
    `-logp[target]`."""


def mse_loss(a, b) -> Any:
    """The mean squared error of each row: `mean((a - b)^2)`."""


def l1_loss(a, b) -> Any:
    """The mean absolute error of each row: `mean(|a - b|)`."""


def smooth_l1_loss(a, b, beta) -> Any:
    """Each row's mean of `0.5 d^2 / beta` where `|d| < beta` and `|d| - 0.5 beta`
    elsewhere, `d = a - b`: the L1 loss with a quadratic bowl around 0, Fast
    R-CNN's. `beta > 0`."""


def kl_div(logp, q) -> Any:
    """The KL divergence of each row of `q` from `p`, `p` given by its
    log-probabilities `logp`: `sum q (log q - logp)`, a `q` of 0 adding 0. The
    mean over the rows is PyTorch's `reduction="batchmean"`."""


def binary_cross_entropy_with_logits(x, y) -> Any:
    """Binary cross-entropy of the logits `x` against the targets `y` in
    `[0, 1]`, each row's mean, in the form that neither overflows nor loses a
    small probability: `max(x, 0) - x y + log(1 + e^-|x|)`."""


def hash32(x) -> Any:
    """The `lowbias32` hash of each element of the `i32` value `x`."""


def uniform(seed, counter) -> Any:
    """A number in `[0, 1)` for each counter, uniform on a grid of `2^-23`: the
    hash's low 23 bits."""


def randn(seed, counter) -> Any:
    """A standard normal number for each counter, the Box-Muller transform of
    the uniform pair at counters `2 counter` and `2 counter + 1`. The
    uniform's grid ends its tails near 5.6."""


def dropout(x, p, seed, counter) -> Any:
    """Dropout: each element of `x` zeroed with probability `p` and the kept
    ones scaled by `1 / (1 - p)`, so the expectation is `x`. `p` in `[0, 1)`."""
