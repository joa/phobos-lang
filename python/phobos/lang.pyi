# The standard library.


def cdiv(a, b) -> Any:
    """The number of `b`-sized pieces that cover `a`: `ceil(a / b)` for
    positive integers. The grid of a kernel tiling `N` by `T` is `cdiv(N, T)`."""


def round_up(a, b) -> Any:
    """`a` rounded up to a multiple of `b`, for positive integers."""


def square(x) -> Any:
    """`x * x`."""


def rcp(x) -> Any:
    """`1 / x`."""


def clamp(x, lo, hi) -> Any:
    """`x` limited to `[lo, hi]`, for `lo <= hi`."""


def lerp(a, b, w) -> Any:
    """The point `w` of the way from `a` to `b`: `a` at 0, `b` at 1."""


def exp2(x) -> Any:
    """`2^x` and `log2(x)`, as approximate as `exp` and `log`."""


def log2(x) -> Any:
    ...


def sign(x) -> Any:
    """-1 for a negative `x`, 1 for a positive one. Within `1e-30` of zero the
    result runs linearly through 0, so it is 0 at 0."""


def erf(x) -> Any:
    """The error function, by Abramowitz and Stegun's 7.1.26: within 1.5e-7 of
    `erf` on every input, before the rounding of `exp`."""


def relu(x) -> Any:
    """`max(x, 0)`."""


def relu6(x) -> Any:
    """`relu`, capped at 6."""


def leaky_relu(x, slope) -> Any:
    """`x` for a positive `x`, `slope * x` otherwise. `slope` in `[0, 1]`."""


def hardtanh(x) -> Any:
    """`x` limited to `[-1, 1]`."""


def threshold(x, th, value) -> Any:
    """`x` where it is above `th`, `value` elsewhere."""


def hardshrink(x, l) -> Any:
    """Shrinkage, as sparse coding uses it: `hardshrink` zeroes `[-l, l]` and
    keeps `x` outside it, `softshrink` zeroes it and moves the rest `l`
    toward 0, and `tanhshrink` is `x - tanh(x)`. `l >= 0`."""


def softshrink(x, l) -> Any:
    ...


def tanhshrink(x) -> Any:
    ...


def elu(x, alpha) -> Any:
    """`x` for a positive `x`, `alpha * (e^x - 1)` otherwise. `alpha > 0`."""


def selu(x) -> Any:
    """`elu` scaled to be self-normalizing, with the constants of Klambauer et al."""


def celu(x, alpha) -> Any:
    """`x` for a positive `x`, `alpha * (e^(x / alpha) - 1)` otherwise. `alpha > 0`."""


def sigmoid(x) -> Any:
    """The logistic function, `1 / (1 + e^-x)`."""


def log_sigmoid(x) -> Any:
    """`log(sigmoid(x))`, without the overflow of computing it so."""


def hardsigmoid(x) -> Any:
    """A piecewise-linear `sigmoid`: 0 below -3, 1 above 3."""


def silu(x) -> Any:
    """`x * sigmoid(x)`, also called swish."""


def swish(x, beta) -> Any:
    """`x * sigmoid(beta * x)`."""


def hardswish(x) -> Any:
    """`x * hardsigmoid(x)`, MobileNetV3's."""


def gelu(x) -> Any:
    """`x * Phi(x)`, `Phi` the standard normal's CDF, through `erf`: PyTorch's
    `gelu` with `approximate="none"`."""


def gelu_tanh(x) -> Any:
    """`gelu` by its tanh approximation, GPT-2's: PyTorch's `approximate="tanh"`."""


def quick_gelu(x) -> Any:
    """`x * sigmoid(1.702 * x)`, CLIP's cheaper approximation of `gelu`."""


def softplus(x) -> Any:
    """`log(1 + e^x)`, in the form that neither overflows for a large `x` nor
    loses a small one."""


def mish(x) -> Any:
    """`x * tanh(softplus(x))`."""


def softsign(x) -> Any:
    """`x / (1 + |x|)`."""


def squared_relu(x) -> Any:
    """`relu(x)^2`, Primer's."""


