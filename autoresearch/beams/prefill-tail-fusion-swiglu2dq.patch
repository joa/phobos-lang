+    /// [`Backend::swiglu_planes_q`]'s fused form, keeping [`Backend`]'s own
+    /// impl block a thin call layer.
+    pub(super) fn swiglu_planes_quantized(
+        &self,
+        gate: Plane,
+        up: Plane,
+        out: Buf,
+        rows: usize,
+        width: usize,
+    ) -> Result<QAct> {
+        self.check_distinct("swiglu_planes_q", out, &[gate.buf, up.buf]);
+        let tile = swiglu_2d_q_tile(width);
+        // The reshaped kernel addresses both planes in whole Q8_0 blocks, so it
+        // needs a tile that divides evenly into one and a pitch the two planes
+        // agree on; whatever declines takes the unfused pair, which is exactly
+        // the trait's default for this method.
