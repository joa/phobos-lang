+                        ),
+                        (self.ptr(up.buf, up.offset)?, [(rows as i64) * 2 * qb, rb]),
+                        (self.ptr(out, 0)?, [(rows as i64) * qb, rb]),
+                        (qa_ptr, [(rows as i64) * qb, rb]),
+                        (das_ptr, [(rows as i64) * qb, 1]),
+                    ],
+                    (rows as u32, (width / tile) as u32, 1),
+                )
+            },
+        )?;
