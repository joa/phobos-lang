+use crate::backend::Q8_BLOCK;
 use phobos_kernels::launch::STATIC_SHARED_LIMIT;
 
 /// Elements per block for the pointwise kernels.
@@ -174,3 +175,60 @@ pub(crate) fn swiglu_2d_tile(width: usize) -> usize {
         .find(|t| width.is_multiple_of(*t))
         .unwrap_or(width)
 }
+
+/// [`swiglu_2d_q_src`]'s column tile. Wider than [`swiglu_2d_src`]'s own
+/// tiles hold: that kernel keeps three operands (`G`, `U`, `O`) live at once,
+/// this one keeps six (`G`, `U`, the SwiGLU product, the scaled-for-rounding
+/// copy, and `O`'s and `Q`'s own staging), so the same 48 KB static ceiling
+/// fits a narrower tile. Measured, not derived: a whole-row tile at 3584 (one
+/// of `swiglu_2d_tile`'s own shapes) compiled and JIT-loaded for the plain
+/// kernel and failed to load for this one, over the static shared-memory
+/// ceiling.
+pub(crate) fn swiglu_2d_q_tile(width: usize) -> usize {
+    const OPERANDS: usize = 4;
+    let fits = STATIC_SHARED_LIMIT / (OPERANDS * size_of::<f32>());
+    (1..=width.min(fits))
+        .rev()
+        .find(|t| width.is_multiple_of(*t))
+        .unwrap_or(width)
+}
+
+/// [`swiglu_2d_src`], with the epilogue [`swiglu_q_src`] adds to the flat
+/// SwiGLU: a quantized copy behind the down projection that reads this, one
+/// scale per [`Q8_BLOCK`].
+///
+/// Reshaped the same way [`rms_norm_src`] reshapes its row: every tensor here
+/// is addressed in whole blocks of [`Q8_BLOCK`] rather than elements, so
+/// `rowmax` sees the same run a Q8_0 scale covers without a cross-program
+/// reduction. This only typechecks when a program's column tile divides into
+/// whole blocks, which the caller has to check -- see [`swiglu_2d_q_tile`]'s
+/// doc comment for why a tile can come out narrower than a block on an
+/// unusual `width`.
+///
+/// The gate and up planes share one pitch (`2 * width`, the fused
+/// gate-and-up projection's output width) which the caller asserts; the
+/// output is dense at `width`, half that.
+pub(crate) fn swiglu_2d_q_src(width: usize, tile: usize) -> String {
+    let nb = tile / Q8_BLOCK;
+    let pb = (2 * width) / Q8_BLOCK;
+    let ob = width / Q8_BLOCK;
+    format!(
+        "@launch(256)
+@autotune(NB in [{nb}])
+kernel swiglu_2d_q(G: tensor<f32>[RG, {Q8_BLOCK}], U: tensor<f32>[RU, {Q8_BLOCK}],
+                    O: tensor<f32>[RO, {Q8_BLOCK}], Q: tensor<i8>[RO, {Q8_BLOCK}],
+                    S: tensor<f32>[RO, D1]) {{
+  let r = program_id(0)
+  let c = program_id(1) * NB
+  var g = G[r * {pb} + c :+ NB, 0 :+ {Q8_BLOCK}]
+  var u = U[r * {pb} + c :+ NB, 0 :+ {Q8_BLOCK}]
+  var y: tile<f32>[NB, {Q8_BLOCK}] = (g / (1.0 + exp(-g))) * u
+  O[r * {ob} + c :+ NB, 0 :+ {Q8_BLOCK}] = y
+  var mx: tile<f32>[NB, 1] = rowmax(tmax(y, -y))
+  var q = y * (127.0 / (mx + 0.00000001))
+  Q[r * {ob} + c :+ NB, 0 :+ {Q8_BLOCK}] = i8(i32(round(q)))
+  S[r * {ob} + c :+ NB, 0 :+ 1] = mx / 127.0
+}}
+"
+    )
+}
