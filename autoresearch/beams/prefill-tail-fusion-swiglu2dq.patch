+        let (rb, qb) = (Q8_BLOCK as i64, blocks as i64);
+        self.with_kernel(
+            &self.swiglu_planes_q,
+            width,
+            "swiglu_2d_q",
+            || swiglu_2d_q_src(width, tile),
+            |module| {
+                self.launch(
+                    module,
+                    "swiglu_2d_q",
+                    &[
+                        (
