---
import Site from "../layouts/Site.astro"
import "../styles/home.css"
import Hero from "../components/home/Hero.astro"
import TilesLanesScene from "../components/home/TilesLanesScene.astro"
import PipelineScene from "../components/home/PipelineScene.astro"
import CompilerNumbers from "../components/home/CompilerNumbers.astro"
import InferenceScene from "../components/home/InferenceScene.astro"
import GetStarted from "../components/home/GetStarted.astro"
import BenchChart from "../components/inference/BenchChart.astro"
---

<Site title="Phobos: tile-based GPU kernel language & LLM inference engine">
  <Hero />
  <TilesLanesScene />
  <PipelineScene />
  <CompilerNumbers />
  <InferenceScene>
    <Fragment slot="numbers"><BenchChart compact id="bench-home" /></Fragment>
  </InferenceScene>
  <GetStarted />
</Site>
