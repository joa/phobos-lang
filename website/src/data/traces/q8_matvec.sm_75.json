{"schema":1,"name":"q8_matvec","kernel":"q8_matvec","source":{"origin":"file","path":"phobos-lang/examples/q8_matvec.ph","text":"// Q8_0 matvec: a decode-step projection that reads the weights quantized.\n//\n// Q8_0 stores signed bytes with one scale per block of 32 values along the\n// contraction axis. Reading the bytes directly moves a quarter of the data\n// an f32 copy would.\n//\n// The scale factors out of a block's dot product, so it is applied once per\n// block and column, not once per weight.\n@autotune(TILE_N in [64], BLK in [32])\n@launch(256)\nkernel q8_matvec(A: tensor<f32>[1, K],\n                 W: tensor<i8>[K, N],\n                 S: tensor<f32>[KB, N],\n                 C: tensor<f32>[1, N]) {\n  let pn = ctx.block.x\n  var acc: tile<f32>[1, TILE_N] = 0.0\n\n  for k in range(0, K, BLK) {\n    let b = k / BLK\n    let a = A[0 :+ 1, k :+ BLK]\n    let w = W[k :+ BLK, pn * TILE_N :+ TILE_N]\n    let s = S[b :+ 1, pn * TILE_N :+ TILE_N]\n\n    var wf: tile<f32>[BLK, TILE_N] = f32(w)\n    var part: tile<f32>[1, TILE_N] = dot(a, wf)\n    acc += part * s\n  }\n\n  C[0 :+ 1, pn * TILE_N :+ TILE_N] = acc\n}\n","sha256":"ce5b4023877a1087030d9b47d3d649394edccd26142beab80b0ec116470e0c0a"},"compiler":{"commit":"5a313cd","chip":"sm_75","indexBits":32},"params":{"BLK":32,"TILE_N":64},"dims":{"K":256,"KB":8,"N":128},"launch":{"grid":[2,1,1],"threads":256,"lanes":32,"warps":8},"tensors":[{"name":"A","elem":"f32","elemBytes":4,"shape":[1,256],"strides":[256,1],"role":"in"},{"name":"W","elem":"i8","elemBytes":1,"shape":[256,128],"strides":[128,1],"role":"in"},{"name":"S","elem":"f32","elemBytes":4,"shape":[8,128],"strides":[128,1],"role":"in"},{"name":"C","elem":"f32","elemBytes":4,"shape":[1,128],"strides":[128,1],"role":"out"}],"ops":[{"id":0,"kind":"assume_align","ir":"%A.4: tensor<f32>[1, ?] = assume_align %A.0","uniformity":"uniform"},{"id":1,"kind":"dim","ir":"%K.5: index = dim 1 %A.0","uniformity":"uniform"},{"id":2,"kind":"assume_align","ir":"%W.6: tenso