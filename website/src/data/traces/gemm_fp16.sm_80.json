{"schema":1,"name":"gemm_fp16","kernel":"gemm","source":{"origin":"file","path":"examples/gemm_fp16.ph","text":"@autotune(TILE_M in [32, 256], TILE_N in [32, 256], TILE_K in [16, 64], U in [1, 8])\n@launch(256, 2)\n@tensorcore\n@aligned(M = TILE_M, N = TILE_N, K = TILE_K)\nkernel gemm(A: tensor<f16>[M, K],\n            B: tensor<f16>[K, N],\n            C: tensor<f16>[M, N],\n            alpha: f32,\n            beta: f32) {\n  let pm = ctx.block.x\n  let pn = ctx.block.y\n\n  var acc: tile<f16>[TILE_M, TILE_N] = 0.0\n  \n  for<unroll U> kt in range(0, K, TILE_K) {\n    var a = A[pm * TILE_M :+ TILE_M, kt :+ TILE_K]\n    var b = B[kt :+ TILE_K, pn * TILE_N :+ TILE_N]\n    acc += dot(a, b)\n  }\n  \n  if beta == 0.0 {\n    C[pm * TILE_M :+ TILE_M, pn * TILE_N :+ TILE_N] = alpha * acc\n  } else {\n    let c_old = C[pm * TILE_M :+ TILE_M, pn * TILE_N :+ TILE_N]\n    C[pm * TILE_M :+ TILE_M, pn * TILE_N :+ TILE_N] = alpha * acc + beta * c_old\n  }\n}\n","sha256":"e1b5abda4a8926b3bb2ff8d29e74316e23f775a2c7dc62de31364bd91709e614"},"compiler":{"commit":"ef0c5be","chip":"sm_80","indexBits":64},"params":{"TILE_K":16,"TILE_M":64,"TILE_N":64,"U":1},"dims":{"K":128,"M":128,"N":128},"launch":{"grid":[2,2,1],"threads":256,"lanes":32,"warps":8},"tensors":[{"name":"A","elem":"f16","elemBytes":2,"shape":[128,128],"strides":[128,1],"role":"in"},{"name":"B","elem":"f16","elemBytes":2,"shape":[128,128],"strides":[128,1],"role":"in"},{"name":"C","elem":"f16","elemBytes":2,"shape":[128,128],"strides":[128,1],"role":"inout"}],"ops":[{"id":0,"kind":"assume_align","ir":"%A.5: tensor<f16>[?, ?]@div[64, 16] = assume_align %A.0","uniformity":"uniform"},{"id":1,"kind":"dim","ir":"%M.6: index = dim 0 %A.0","uniformity":"uniform"},{"id":2,"kind":"dim","ir":"%K.7: index = dim 1 %A.0","uniformity":"uniform"},{"id":3,"kind":"assume_align","ir":"%B.8: tensor<f16>[?, ?]@div[16, 64] = assume_align %B.1","uniformity":"uniform"},{"id":4,"kind":"dim","ir":"%N.9: index = dim 1 %B.1","uniformity":"uniform"}