    "graph": "%38: gemm<f32>[32, 32]/4 = for %27, %K.7, %28, %26 {\n^(%kt.29: index, %30: gemm<f32>[32, 32]/4)\n  %31: index = const 32\n  %32: index = mul %pm.23, %31\n  %33: tile<f32>[32, 4]@global{align 4} = slice [32, 4] %A.5, %32, %kt.29\n  %34: index = const 32\n  %35: index = mul %pn.24, %34\n  %36: tile<f32>[4, 32]@global{align 32} = slice [4, 32] %B.8, %kt.29, %35\n  %37: gemm<f32>[32, 32]/4 = gemm_dot %30, %33, %36\n  yield %37",
    "passes": "// TILE_M=32 TILE_N=32 TILE_K=4, sm_75\ntile0   512 B at    0  dot staging\ntile1   512 B at  512  dot staging\ntile2   512 B at 1024  dot staging\ntile3   512 B at 1536  dot staging\npeak 2048 B of shared memory\nbarriers: 1 kept, 0 elided",
    "mlir": "%29 = scf.for %arg5 = %c0_9 to %dim_0 step %28 iter_args(%arg6 = %6) -> (vector<4x4xf32>) {\n  %31 = arith.addi %arg5, %c4_10 : index\n  %32 = arith.subi %dim_0, %c4_10 : index\n  %33 = arith.minsi %31, %32 : index\n  %c32_38 = arith.constant 32 : index\n  %34 = arith.muli %block_id_x, %c32_38 : index\n  %subview_39 = memref.subview %assume_align[%34, %33] [32, 4] [1, 1] : memref<?x?xf32, 1> to memref<32x4xf32, strided<[?, 1], offset: ?>, 1>\n  %c32_40 = arith.constant 32 : index\n  %35 = arith.muli %block_id_y, %c32_40 : index\n...",
