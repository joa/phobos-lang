    "source": {
      "path": "examples/gemm_fp32.ph",
      "lines": [
        {
          "n": 1,
          "text": "@autotune(TILE_M in [32, 256], TILE_N in [32, 256], TILE_K in [4, 32], U in [1, 8], T in [256, 128], IB in [32, 64])",
          "role": "attribute"
        },
        { "n": 2, "text": "@launch(T)", "role": "attribute" },
        { "n": 3, "text": "@index_bits(IB)", "role": "attribute" },
        { "n": 4, "text": "@pipeline", "role": "attribute" },
        { "n": 5, "text": "@aligned(M = TILE_M, N = TILE_N, K = TILE_K)", "role": "attribute" },
        { "n": 6, "text": "kernel gemm(A: tensor<f32>[M, K],", "role": "signature" },
        { "n": 7, "text": "              B: tensor<f32>[K, N],", "role": "signature" },
        { "n": 8, "text": "              C: tensor<f32>[M, N],", "role": "signature" },
        { "n": 9, "text": "              alpha: f32,", "role": "signature" },
        { "n": 10, "text": "              beta: f32) {", "role": "signature" },
        { "n": 11, "text": "  let pm = ctx.block.x", "role": "code" },
        { "n": 12, "text": "  let pn = ctx.block.y", "role": "code" },
        { "n": 13, "text": "", "role": "blank" },
        { "n": 14, "text": "  var acc: tile<f32>[TILE_M, TILE_N] = 0.0", "role": "code" },
        { "n": 15, "text": "", "role": "blank" },
        { "n": 16, "text": "  for<unroll U> kt in range(0, K, TILE_K) {", "role": "loop-header" },
        { "n": 17, "text": "    var a = A[pm * TILE_M :+ TILE_M, kt :+ TILE_K]", "role": "loop-body" },
        { "n": 18, "text": "    var b = B[kt :+ TILE_K, pn * TILE_N :+ TILE_N]", "role": "loop-body" },
        { "n": 19, "text": "    acc += dot(a, b)", "role": "loop-body" },
        { "n": 20, "text": "  }", "role": "loop-end" },
        { "n": 21, "text": "", "role": "blank" },
        { "n": 22, "text": "  if beta == 0.0 {", "role": "code" },
        { "n": 23, "text": "    C[pm * TILE_M :+ TILE_M, pn * TILE_N :+ TILE_N] = alpha * acc", "role": "code" },
        { "n": 24, "text": "  } else {", "role": "code" },
        { "n": 25, "text": "    let c_old = C[pm * TILE_M :+ TILE_M, pn * TILE_N :+ TILE_N]", "role": "code" },
        {
          "n": 26,
          "text": "    C[pm * TILE_M :+ TILE_M, pn * TILE_N :+ TILE_N] = alpha * acc + beta * c_old",
          "role": "code"
        },
        { "n": 27, "text": "  }", "role": "code" },
        { "n": 28, "text": "}", "role": "code" }
      ],
      "loop": { "header": 16, "body": [17, 18, 19], "end": 20 }
    },
