---
// Scene 6: get started, three steps. Commands call the binaries a release ships.
import { installCommands, latestReleaseTag } from "../../lib/release"

const REPO_URL = "https://github.com/joa/phobos-lang"
const release = await latestReleaseTag()
const INSTALL_COMMANDS = release ? installCommands(release) : []
const COMPILE_COMMAND = "phobos-compile gemm_fp32.ph"
const SERVE_COMMAND =
  "phobos-cli --listen 127.0.0.1:8080 --gguf minicpm5-1b-Q8_0.gguf --temp 0.9 --top-p 0.95 -n 32768"
---

<section class="scene get-started" id="get-started" aria-labelledby="start-title">
  <div class="wrap">
    <div class="scene-head">
      <h2 class="scene-title" id="start-title">Get started</h2>
    </div>
    <ol class="steps">
      <li class="step">
        <h3>Download a release</h3>
        <p>Prebuilt <code>phobos-cli</code>, <code>phobos-compile</code>, <code>phobos-bench</code> and <code>phobos-cache</code> for Windows and Linux, x64.</p>
        {
          release && (
            <div class="install">
              {
                INSTALL_COMMANDS.map(({ os }, i) => (
                  <>
                    <input type="radio" name="install-os" id={`install-${os}`} checked={i === 0} />
                    <label for={`install-${os}`}>{os}</label>
                  </>
                ))
              }
              {INSTALL_COMMANDS.map(({ os, command }) => (
                <pre data-os={os}><code>{command}</code></pre>
              ))}
            </div>
          )
        }
        <a class="button" href={`${REPO_URL}/releases/latest`}>Latest release</a>
      </li>
      <li class="step">
        <h3>Compile a kernel</h3>
        <p>
          Compile a kernel source, such as{" "}
          <a href={`${REPO_URL}/blob/main/examples/gemm_fp32.ph`}>gemm_fp32.ph</a> from the repository's examples, to
          PTX for <code>sm_75</code> by default. No GPU needed.
        </p>
        <pre><code>{COMPILE_COMMAND}</code></pre>
      </li>
      <li class="step">
        <h3>Serve a model</h3>
        <p>
          Download <a href="https://huggingface.co/Abiray/MiniCPM5-1B-GGUF">MiniCPM5-1B-Q8_0</a>, then start the
          OpenAI-compatible server with the dashboard on the terminal. Needs an NVIDIA GPU.
        </p>
        <pre><code>{SERVE_COMMAND}</code></pre>
      </li>
    </ol>
    <a class="scene-link" href="/docs/getting-started/">Read the getting started guide</a>
  </div>
</section>

<style>
  .steps {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--grid-gap);
    margin: 0;
    padding: 0;
    list-style: none;
    counter-reset: step;
  }

  .step {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.75rem;
    min-width: 0;
    padding-top: 1.25rem;
    border-top: 1px solid var(--sky-line);
    counter-increment: step;
  }

  .step h3 {
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
    font-size: 1.1875rem;
  }

  .step h3::before {
    content: counter(step);
    color: var(--brand);
    font-family: var(--font-mono);
    font-size: 0.875rem;
  }

  .step p {
    margin: 0;
    color: var(--dust);
    font-size: 0.9375rem;
  }

  .step p code {
    color: var(--star);
  }

  .step pre {
    width: 100%;
    margin: 0.25rem 0 0;
    padding: 0.875rem 1rem;
    overflow-x: auto;
    border: 1px solid var(--sky-line);
    background: var(--sky-1);
    color: var(--star);
    font-size: 0.8125rem;
    line-height: 1.55;
    white-space: pre-wrap;
    overflow-wrap: anywhere;
  }

  .install {
    display: flex;
    flex-wrap: wrap;
    width: 100%;
  }

  .install input {
    position: absolute;
    opacity: 0;
    pointer-events: none;
  }

  .install label {
    padding: 0.25rem 0.75rem;
    border-bottom: 1px solid transparent;
    color: var(--dust);
    font-size: 0.8125rem;
    cursor: pointer;
  }

  .install input:checked + label {
    border-bottom-color: var(--brand);
    color: var(--star);
  }

  .install input:focus-visible + label {
    outline: 2px solid var(--brand);
    outline-offset: 2px;
  }

  .install pre {
    display: none;
  }

  .install:has(#install-Linux:checked) pre[data-os="Linux"],
  .install:has(#install-Windows:checked) pre[data-os="Windows"] {
    display: block;
  }

  .step .button {
    margin-top: 0.25rem;
  }

  @media (max-width: 900px) {
    .steps {
      grid-template-columns: minmax(0, 1fr);
      gap: 2rem;
    }
  }
</style>
