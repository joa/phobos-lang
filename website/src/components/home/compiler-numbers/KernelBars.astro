---
// The kernel benchmark, Phobos against cuBLAS, one tab per card from results/platforms/*/card.json and one
// row per kernel. A row's track is the peak phobos-kbench derives for its precision on that card, so a bar's
// length is its share of that peak and the two bars of a row share one scale. saxpy is memory-bound and
// drawn in GB/s against the faster of the two. cuBLAS gets a bar only where it ran at the kernel's own
// precision. Every card's rows are rendered; the tabs only toggle which one shows.
import { formatGflops, formatPercent, precisionLabel } from "../../../lib/bench/kernels"
import { commitUrl, REPO_URL, shortDate } from "../../../lib/bench/load"
import { loadPlatforms, type KernelStat, type Platform } from "../../../lib/bench/platforms"

interface Props {
  id?: string
}

const { id = "kernels" } = Astro.props
const platforms = loadPlatforms()
// The development card, which the kernels are tuned on.
const initial = platforms[0]

// The gemms that read f32 or f16 and accumulate in f32 on tensor cores need the explanation their pages
// give; one bar each says too little, so they stay on the platforms page.
const HIDDEN = new Set(["gemm_fp16tc_fp32acc", "gemm_fp16_fp32acc"])

interface Bar {
  impl: "phobos" | "cublas"
  widthPercent: number
  value: string
  share: string
}

interface Row {
  kernel: KernelStat
  headline: string
  bars: Bar[]
  aside?: string
  scale: string
  label: string
}

const gbs = (value: number) => `${Math.round(value)} GB/s`

function rowOf(kernel: KernelStat): Row {
  const measures: [Bar["impl"], number][] = [["phobos", kernel.phobos.mean]]
  if (kernel.cublas) measures.push(["cublas", kernel.cublas.mean])

  let bars: Bar[]
  let scale: string
  if (kernel.bytesPerFlop !== undefined) {
    const rates = measures.map(([, gflops]) => gflops * kernel.bytesPerFlop!)
    const top = Math.max(...rates)
    bars = measures.map(([impl], index) => ({
      impl,
      widthPercent: (rates[index] / top) * 100,
      value: gbs(rates[index]),
      share: "",
    }))
    scale = "memory-bound, in GB/s"
  } else {
    bars = measures.map(([impl, gflops]) => {
      const percent = (gflops / kernel.peakGflops) * 100
      return { impl, widthPercent: percent, value: formatGflops(gflops), share: `${Math.round(percent)}%` }
    })
    scale = `${kernel.inputs ? `${kernel.inputs}, ` : ""}${precisionLabel(kernel.precision)}, peak ${formatGflops(kernel.peakGflops)}`
  }

  let headline: string
  let aside: string | undefined
  if (kernel.ratio) {
    headline = `${formatPercent(kernel.ratio.mean)} of cuBLAS`
    aside = kernel.cublasNote
  } else if (kernel.cublasRan) {
    headline = "no like-for-like cuBLAS"
    aside = `cuBLAS in this run is ${kernel.cublasCall} at another precision, so no bar`
  } else {
    headline = "no cuBLAS counterpart"
  }

  const spoken = bars.map(bar => `${bar.impl === "phobos" ? "Phobos" : "cuBLAS"} ${bar.value}${bar.share ? `, ${bar.share} of peak` : ""}`)
  const label = [kernel.size, scale, ...spoken, headline, ...(aside ? [aside] : [])].join("; ")
  return { kernel, headline, bars, aside, scale, label }
}

interface Panel {
  platform: Platform
  key: string
  rows: Row[]
}

const panels: Panel[] = platforms.map(platform => ({
  platform,
  key: platform.dir.split("/").pop()!,
  rows: platform.kernels.filter(kernel => !HIDDEN.has(kernel.benchmark)).map(rowOf),
}))
const cublasCalls = [
  ...new Set(panels.flatMap(panel => panel.rows.filter(row => row.kernel.cublas).map(row => row.kernel.cublasCall))),
]
const blob = (file: string) => `${REPO_URL}/blob/main/${file}`
const runsText = (runs: number) => (runs === 1 ? "one phobos-kbench run" : `the mean of ${runs} phobos-kbench runs`)
---

<div class="kb-wrap">
  <figure class="kb" id={id} aria-labelledby={`${id}-title`} data-kb>
    <figcaption class="kb-head">
      <p class="kb-title" id={`${id}-title`}>Kernel throughput against cuBLAS, higher is better</p>
      <div class="kb-tabs" role="tablist" aria-label="Card">
        {
          panels.map(panel => (
            <button
              type="button"
              role="tab"
              class="kb-tab"
              id={`${id}-tab-${panel.key}`}
              aria-controls={`${id}-panel-${panel.key}`}
              aria-selected={panel.platform === initial ? "true" : "false"}
              tabindex={panel.platform === initial ? 0 : -1}
              data-kb-tab={panel.key}
            >
              {panel.platform.card.replace(/^RTX /, "")}
            </button>
          ))
        }
      </div>
      <ul class="kb-legend" aria-label="Legend">
        <li class="kb-key is-phobos">Phobos</li>
        <li class="kb-key is-cublas">cuBLAS ({cublasCalls.join(", ")})</li>
      </ul>
    </figcaption>

    {
      panels.map(({ platform, key, rows }) => (
        <div
          class="kb-panel"
          role="tabpanel"
          id={`${id}-panel-${key}`}
          aria-labelledby={`${id}-tab-${key}`}
          data-kb-panel={key}
          hidden={platform !== initial}
        >
          <p class="kb-meta">
            {platform.card}, <code>{platform.chip}</code>, {platform.kbenchPowerLimitWatts ?? platform.powerLimitWatts} W
            limit, {platform.kbenchHost ?? platform.host}; {runsText(platform.kernelFiles.length)}, each kernel
            autotuned, at <a href={commitUrl(platform.kbenchCommit)}>{platform.kbenchCommit}</a>
            {platform.date && <>, {shortDate(platform.date)}</>} (
            {platform.kernelFiles.map((file, index) => (
              <>
                {index > 0 && ", "}
                <a href={blob(file)}>run {index + 1}</a>
              </>
            ))}
            )
          </p>
          <div class="kb-rows">
            {rows.map(row => (
              <div class="kb-row" role="group" aria-label={row.kernel.label}>
                <div class="kb-name">
                  {row.kernel.example ? <a href={row.kernel.example}>{row.kernel.label}</a> : <span>{row.kernel.label}</span>}
                  <span class="kb-size">
                    {row.kernel.size}, {row.scale}
                  </span>
                </div>
                <div class="kb-plot" role="img" aria-label={row.label}>
                  <span class:list={["kb-headline", { "is-quiet": !row.kernel.ratio }]} aria-hidden="true">
                    {row.headline}
                  </span>
                  {row.bars.map(bar => (
                    <span class="kb-bar-row" aria-hidden="true">
                      <span class="kb-track">
                        <span class={`kb-bar is-${bar.impl}`} style={`width: ${Math.min(bar.widthPercent, 100).toFixed(1)}%`} />
                      </span>
                      <span class="kb-value">
                        {bar.value}
                        {bar.share && (
                          <span class="kb-share">
                            , {bar.share}
                            <span class="kb-of-peak"> of peak</span>
                          </span>
                        )}
                      </span>
                    </span>
                  ))}
                  {row.aside && (
                    <span class="kb-aside" aria-hidden="true">
                      {row.aside}
                    </span>
                  )}
                </div>
              </div>
            ))}
          </div>
        </div>
      ))
    }

    <p class="kb-note">
      A track is the card's peak for the kernel's precision as phobos-kbench derives it from SM count and clock, so a
      bar's length is its share of that peak; saxpy's track is the faster of its two rates. Each value is the mean over
      the card's runs, each of which autotunes afresh. The flash attention kernels carry <code>@tensorcore</code> and run
      their products on tensor cores where the tile shapes qualify; phobos-kbench rates the f32 one against the f32 peak.
      Rates on different cards are not comparable: the hosts and their power limits differ. Every kernel on every card is
      on the <a href="/docs/getting-started/platforms/">supported platforms</a> page.
    </p>
  </figure>
</div>

<script>
  // A tab picks a card. Anything on the page marked data-kb-card follows it, such as a sentence quoting the
  // selected card's numbers.
  for (const figure of document.querySelectorAll<HTMLElement>("[data-kb]")) {
    const tabs = [...figure.querySelectorAll<HTMLButtonElement>("[data-kb-tab]")]
    const select = (tab: HTMLButtonElement) => {
      const key = tab.dataset.kbTab
      for (const other of tabs) {
        other.setAttribute("aria-selected", String(other === tab))
        other.tabIndex = other === tab ? 0 : -1
      }
      for (const panel of figure.querySelectorAll<HTMLElement>("[data-kb-panel]")) panel.hidden = panel.dataset.kbPanel !== key
      for (const echo of document.querySelectorAll<HTMLElement>("[data-kb-card]")) echo.hidden = echo.dataset.kbCard !== key
    }
    tabs.forEach((tab, index) => {
      tab.addEventListener("click", () => select(tab))
      tab.addEventListener("keydown", event => {
        const step = event.key === "ArrowRight" ? 1 : event.key === "ArrowLeft" ? -1 : 0
        if (step === 0) return
        event.preventDefault()
        const next = tabs[(index + step + tabs.length) % tabs.length]
        next.focus()
        select(next)
      })
    })
  }
</script>

<style>
  .kb-wrap {
    container: kb / inline-size;
  }

  .kb {
    --series-phobos: var(--brand);
    margin: 0;
    font-family: var(--font-mono);
    color: var(--star);
  }

  .kb-head {
    display: grid;
    gap: 0.375rem;
    margin-bottom: 1.25rem;
  }

  .kb-title {
    margin: 0;
    font-family: var(--font-sans);
    font-size: 1rem;
    font-weight: 600;
  }

  .kb-meta,
  .kb-size,
  .kb-legend,
  .kb-value,
  .kb-aside {
    color: var(--dust);
    font-size: 0.75rem;
    line-height: 1.5;
  }

  .kb-meta {
    margin: 0 0 0.75rem;
  }

  .kb-tabs {
    display: flex;
    flex-wrap: wrap;
    margin-top: 0.25rem;
    border-bottom: 1px solid var(--sky-line);
  }

  .kb-tab {
    margin: 0;
    padding: 0.375rem 0.875rem;
    border: 0;
    background: transparent;
    box-shadow: inset 0 -2px 0 transparent;
    color: var(--dust);
    font: inherit;
    font-size: 0.8125rem;
    line-height: 1.4;
    cursor: pointer;
    transition: color var(--dur-1) var(--ease-out);
  }

  .kb-tab:hover {
    color: var(--star);
  }

  .kb-tab[aria-selected="true"] {
    color: var(--star);
    box-shadow: inset 0 -2px 0 var(--brand);
  }

  .kb-tab:focus-visible {
    outline: 2px solid var(--brand);
    outline-offset: -2px;
  }

  .kb-legend {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1.25rem;
    margin: 0.25rem 0 0;
    padding: 0;
    list-style: none;
  }

  .kb-key {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
  }

  .kb-key::before {
    content: "";
    width: 1rem;
    height: 6px;
    background: var(--series-phobos);
  }

  .kb-key.is-cublas::before {
    background: var(--series-cublas);
  }

  .kb-row {
    display: grid;
    grid-template-columns: minmax(12rem, 1fr) minmax(0, 1.6fr);
    column-gap: 2rem;
    align-items: start;
    padding-block: 0.875rem;
    border-top: 1px solid var(--sky-line);
  }

  .kb-name {
    display: grid;
    gap: 0.25rem;
    min-width: 0;
    font-size: 0.8125rem;
  }

  .kb-name a {
    color: var(--star);
    text-decoration-color: var(--sky-line);
    text-underline-offset: 0.2em;
  }

  .kb-name a:hover {
    text-decoration-color: var(--brand);
  }

  .kb-plot {
    display: grid;
    row-gap: 0.3125rem;
    min-width: 0;
  }

  .kb-headline {
    font-size: 0.8125rem;
    font-variant-numeric: tabular-nums;
  }

  .kb-headline.is-quiet {
    color: var(--dust);
  }

  .kb-bar-row {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 12rem;
    align-items: center;
    gap: 0.75rem;
  }

  /* The track is the peak: a hairline to its end, so an empty stretch reads as headroom */
  .kb-track {
    position: relative;
    height: 8px;
    background: linear-gradient(var(--sky-line), var(--sky-line)) left center / 100% 1px no-repeat;
    border-right: 1px solid var(--sky-line);
  }

  .kb-bar {
    display: block;
    height: 100%;
    background: var(--series-phobos);
  }

  .kb-bar.is-cublas {
    background: var(--series-cublas);
  }

  .kb-value {
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }

  .kb-aside {
    max-width: 34rem;
    font-family: var(--font-sans);
  }

  .kb-note {
    max-width: 52rem;
    margin: 1rem 0 0;
    color: var(--dust);
    font-family: var(--font-sans);
    font-size: 0.8125rem;
    line-height: 1.5;
    text-wrap: pretty;
  }

  @container kb (width < 640px) {
    .kb-row {
      grid-template-columns: minmax(0, 1fr);
      row-gap: 0.5rem;
    }

    .kb-bar-row {
      grid-template-columns: minmax(0, 1fr) auto;
    }

    .kb-of-peak {
      display: none;
    }
  }
</style>
