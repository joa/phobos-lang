---
// Scene 3: one compiler, source to PTX, as a journey through seven stations for examples/gemm_fp32.ph.
// Each station is drawn from the compiler's real output (src/data/pipeline/gemm_fp32.json): the source
// lines, the AST as a tree, the graph IR as its DAG, the shared-memory passes, the MLIR region tree,
// the PTX instruction mix and the launch. A point cloud behind the drawings carries the data from one
// station to the next; a ring of stations above shows where the journey is and jumps on a click.
// Without script or motion the scene is the graph IR with the ring, drawn at build time.
import "../../styles/chart.css"
import { shapesMarkup } from "./pipeline/markup"
import { ringPaths, ringSpot } from "./pipeline/ring"
import { allGeometry, OVERVIEW_STATION, STATIONS } from "./pipeline/stations"
import { FRAMES, TONES, type Layout } from "./pipeline/types"

const layouts: Layout[] = ["wide", "narrow"]
const drawings = layouts.map(layout => ({
  layout,
  frame: FRAMES[layout],
  stations: allGeometry(layout).map((geometry, index) => ({
    markup: shapesMarkup(geometry.shapes),
    plate: STATIONS[index].plate,
  })),
}))
const ring = ringPaths()
const count = STATIONS.length
const spots = STATIONS.map((_, index) => ringSpot(index, count, OVERVIEW_STATION))
const tick = (width: number, height: number) => {
  const l = 10
  return [
    `M0 ${l}V0H${l}`,
    `M${width - l} 0H${width}V${l}`,
    `M${width} ${height - l}V${height}H${width - l}`,
    `M${l} ${height}H0V${height - l}`,
  ].join("")
}
const desc =
  "The compiler's stations for the gemm kernel: the source lines, the AST, the graph IR as a graph of ops and values with the k loop as a region and its carried accumulator, the shared-memory passes, the MLIR region tree, the PTX instruction mix and the launch grid."
---

<section class="scene pipeline" id="compiler" aria-labelledby="pipeline-title">
  <div class="wrap">
    <div class="scene-head">
      <h2 class="scene-title" id="pipeline-title">One compiler, source to PTX</h2>
      <p class="scene-intro">
        Seven stations between a kernel file and the card, for <code>gemm_fp32.ph</code>, each drawn from what the
        compiler holds there. The same points travel the whole way.
      </p>
    </div>

    <div class="pp" data-station={STATIONS[OVERVIEW_STATION].id} data-overview={OVERVIEW_STATION}>
      <nav class="pp-ring" aria-label="Compiler stations">
        <svg class="pp-ring-svg" viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true">
          <path class="pp-ring-back" d={ring.back}></path>
          <path class="pp-ring-front" d={ring.front}></path>
        </svg>
        <ol class="pp-spots">
          {
            STATIONS.map((station, index) => (
              <li
                class="pp-spot"
                style={`--x: ${spots[index].x}%; --y: ${spots[index].y}%; --depth: ${spots[index].depth}; z-index: ${Math.round(spots[index].depth * 10)}`}
              >
                <button type="button" data-goto={index} aria-pressed={index === OVERVIEW_STATION ? "true" : "false"}>
                  <span class="pp-dot" aria-hidden="true">
                    <svg viewBox="0 0 20 20">
                      <circle class="pp-dot-core" cx="10" cy="10" r="3.5"></circle>
                      <circle class="pp-dot-progress" cx="10" cy="10" r="8" pathLength="1"></circle>
                    </svg>
                  </span>
                  <span class="pp-name">{station.label}</span>
                </button>
              </li>
            ))
          }
        </ol>
      </nav>

      <div class="pp-stage chart">
        <canvas class="pp-canvas" aria-hidden="true"></canvas>
        {
          drawings.map(({ layout, frame, stations }) => (
            <svg
              class={`pp-svg is-${layout}`}
              viewBox={`0 0 ${frame.width} ${frame.height}`}
              role="img"
              aria-labelledby={`pp-title-${layout} pp-desc-${layout}`}
            >
              <title id={`pp-title-${layout}`}>The compiler's stations for gemm_fp32.ph</title>
              <desc id={`pp-desc-${layout}`}>{desc}</desc>
              <path class="pp-ticks" d={tick(frame.width, frame.height)} />
              {stations.map(({ markup, plate }, index) => (
                <g class:list={["pp-st", { "is-on": index === OVERVIEW_STATION }]} data-st={STATIONS[index].id}>
                  <text class="pp-plate" x="16" y="24">
                    {layout === "wide" ? plate : plate.replace(/^FIG \/ GEMM_FP32( WITHOUT @ALIGNED)? \/ /, "")}
                  </text>
                  <Fragment set:html={markup} />
                </g>
              ))}
            </svg>
          ))
        }
        <div class="pp-probes" aria-hidden="true">
          {TONES.map(tone => <span class={`t-${tone}`} />)}
        </div>
      </div>

      <div class="pp-caps">
        {
          STATIONS.map((station, index) => (
            <p class:list={["pp-cap", { "is-on": index === OVERVIEW_STATION }]}>
              <strong>{station.label}</strong>
              <span>{station.caption}</span>
            </p>
          ))
        }
      </div>

      <ol class="pp-sr">
        {
          STATIONS.map(station => (
            <li>
              {station.label}: {station.caption}
            </li>
          ))
        }
      </ol>
    </div>
  </div>
</section>

<script>
  import { mountPipeline } from "./pipeline/scene"

  for (const root of document.querySelectorAll<HTMLElement>(".pp")) mountPipeline(root)
</script>

<style>
  .pp {
    container-type: inline-size;
    --p: 0;
  }

  /* The ring of stations */

  .pp-ring {
    position: relative;
    height: 7.5rem;
    margin: 0 auto 0.5rem;
    max-width: 52rem;
  }

  .pp-ring-svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
  }

  .pp-ring-back,
  .pp-ring-front {
    fill: none;
    vector-effect: non-scaling-stroke;
    stroke-width: 1;
  }

  .pp-ring-back {
    stroke: var(--sky-line);
    stroke-dasharray: 2 4;
  }

  .pp-ring-front {
    stroke: color-mix(in srgb, var(--brand) 45%, var(--sky-line));
  }

  .pp-spots {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .pp-spot {
    position: absolute;
    left: var(--x);
    top: var(--y);
    translate: -50% -10px;
  }

  .pp-spot button {
    display: grid;
    justify-items: center;
    gap: 0.125rem;
    padding: 0 0.375rem 0.25rem;
    border: 0;
    background: transparent;
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    white-space: nowrap;
    cursor: pointer;
    color: var(--dust);
    opacity: calc(0.3 + 0.7 * var(--depth));
  }

  .pp-spot button:hover,
  .pp-spot button:focus-visible {
    color: var(--star);
    opacity: 1;
  }

  .pp-dot {
    display: block;
    width: 20px;
    height: 20px;
    scale: calc(0.6 + 0.4 * var(--depth));
  }

  .pp-dot svg {
    display: block;
    width: 100%;
    height: 100%;
    overflow: visible;
  }

  .pp-dot-core {
    fill: var(--sky-0);
    stroke: var(--dust);
    stroke-width: 1.2;
  }

  .pp-dot-progress {
    fill: none;
    stroke: var(--brand);
    stroke-width: 1.2;
    stroke-dasharray: 1 1;
    stroke-dashoffset: 1;
    transform: rotate(-90deg);
    transform-origin: center;
    opacity: 0;
  }

  .pp-spot button[aria-pressed="true"] {
    color: var(--star);
  }

  .pp-spot button[aria-pressed="true"] .pp-dot-core {
    fill: var(--brand);
    stroke: var(--brand);
  }

  .pp[data-live="motion"] .pp-spot button[aria-pressed="true"] .pp-dot-progress {
    opacity: 1;
    stroke-dashoffset: calc(1 - var(--p));
  }

  /* The stage: a dotted plate, the cloud, the drawing */

  .pp-stage {
    position: relative;
    margin: 0;
    background:
      radial-gradient(ellipse at 50% 50%, color-mix(in srgb, var(--brand) 7%, transparent), transparent 70%),
      radial-gradient(circle, var(--sky-line) 0.7px, transparent 1px) center / 20px 20px;
  }

  .pp-canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: none;
  }

  .pp[data-live] .pp-canvas {
    display: block;
  }

  .pp-svg {
    position: relative;
    display: block;
    width: 100%;
    height: auto;
    overflow: visible;
    font-family: var(--font-mono);
  }

  .pp-svg.is-narrow {
    display: none;
  }

  @container (width < 600px) {
    .pp-svg.is-wide {
      display: none;
    }

    .pp-svg.is-narrow {
      display: block;
    }

    .pp-ring {
      height: 6.5rem;
    }

    .pp-spot button {
      font-size: 0.75rem;
    }

    .pp-spot:not(:has(button[aria-pressed="true"])) .pp-name {
      opacity: calc((var(--depth) - 0.55) * 3);
    }
  }

  .pp-probes {
    display: none;
  }

  .pp-probes span {
    color: var(--c);
  }

  .pp-ticks {
    fill: none;
    stroke: var(--dust);
    stroke-width: 1;
  }

  .pp-plate {
    fill: var(--dust);
    font-size: 12.5px;
    letter-spacing: 0.14em;
  }

  .pp-st {
    opacity: 0;
    visibility: hidden;
    transition:
      opacity 280ms var(--ease-out),
      visibility 0s linear 280ms;
  }

  .pp-st.is-on {
    opacity: 1;
    visibility: visible;
    transition: opacity 280ms var(--ease-out);
  }

  /* Tones: where the data lives (global, shared, registers), cost, and the quiet ones */

  .pp :global(.t-global) {
    --c: var(--brand);
  }

  .pp :global(.t-shared) {
    --c: var(--nebula);
  }

  .pp :global(.t-reg) {
    --c: var(--star);
  }

  .pp :global(.t-cost) {
    --c: var(--mars);
  }

  .pp :global(.t-dust) {
    --c: var(--dust);
  }

  .pp :global(.t-line) {
    --c: var(--sky-line);
  }

  .pp :global(.t-hi) {
    --c: var(--brand-hi);
  }

  /* Shapes */

  .pp-svg :global(.pp-label) {
    fill: var(--c, var(--dust));
    font-size: 12.5px;
    font-variant-numeric: tabular-nums;
    white-space: pre;
    paint-order: stroke;
    stroke: var(--sky-0);
    stroke-width: 6px;
    stroke-linejoin: round;
  }

  .pp-svg :global(.pp-label.is-strong) {
    fill: var(--c, var(--star));
  }

  .pp-svg :global(.is-faint) {
    opacity: 0.72;
  }

  .pp-svg :global(.pp-code) {
    font-size: 17px;
    white-space: pre;
  }

  .pp-svg :global(.pp-code.is-small) {
    font-size: 12.5px;
  }

  .pp-svg :global(.pp-code tspan) {
    fill: var(--c);
  }

  .pp-svg :global(.pp-code .t-line) {
    fill: none;
  }

  .pp-svg :global(.pp-band) {
    fill: var(--brand-fill);
  }

  .pp-svg :global(.pp-glyph) {
    fill: var(--c);
    stroke: var(--c);
    stroke-width: 1;
  }

  .pp-svg :global(.pp-glyph.is-ring) {
    fill: var(--sky-0);
    stroke-width: 1.3;
  }

  .pp-svg :global(.pp-wire) {
    fill: none;
    stroke: color-mix(in srgb, var(--c, var(--dust)) 50%, transparent);
    stroke-width: 1;
  }

  .pp-svg :global(.pp-wire.is-faint) {
    stroke: color-mix(in srgb, var(--c, var(--dust)) 30%, transparent);
    opacity: 1;
  }

  .pp-svg :global(.pp-wire.is-strong),
  .pp-svg :global(.pp-wire.is-back) {
    stroke: var(--c);
    stroke-width: 1.4;
  }

  .pp-svg :global(.pp-region) {
    fill: color-mix(in srgb, var(--star) 3%, transparent);
    stroke: color-mix(in srgb, var(--star) 35%, transparent);
    stroke-dasharray: 3 4;
  }

  .pp-svg :global(.pp-region-box) {
    fill: color-mix(in srgb, var(--star) 2.5%, transparent);
    stroke: var(--sky-line);
  }

  .pp-svg :global(.pp-region-box.is-loop) {
    stroke: color-mix(in srgb, var(--brand) 55%, transparent);
  }

  .pp-svg :global(.pp-region-box.is-contract) {
    stroke: color-mix(in srgb, var(--star) 45%, transparent);
  }

  .pp-svg :global(.pp-region-box.is-copy) {
    stroke: color-mix(in srgb, var(--nebula) 50%, transparent);
  }

  .pp-svg :global(.pp-region-box.is-guard) {
    stroke: color-mix(in srgb, var(--mars) 50%, transparent);
  }

  .pp-svg :global(.pp-strip) {
    fill: none;
    stroke: color-mix(in srgb, var(--nebula) 55%, transparent);
  }

  .pp-svg :global(.pp-op) {
    stroke: color-mix(in srgb, var(--c) 75%, transparent);
    stroke-width: 1.5;
  }

  .pp-svg :global(.pp-tick) {
    stroke: var(--dust);
  }

  .pp-svg :global(.pp-buf) {
    fill: var(--nebula-fill-on);
    stroke: var(--nebula);
  }

  .pp-svg :global(.pp-buf.is-retiring) {
    fill-opacity: 0;
    stroke-opacity: 0.55;
    stroke-dasharray: 3 3;
  }

  .pp-svg :global(.pp-buf-label) {
    fill: var(--star);
    stroke: none;
  }

  .pp-svg :global(.pp-buf-label.is-retiring) {
    opacity: 0.5;
  }

  .pp-svg :global(.pp-barrier) {
    stroke-width: 2;
  }

  .pp-svg :global(.pp-barrier.is-kept) {
    stroke: var(--nebula);
  }

  .pp-svg :global(.pp-barrier.is-elided) {
    stroke: var(--dust);
    stroke-dasharray: 2 3;
    opacity: 0.45;
  }

  .pp-svg :global(.pp-cursor) {
    stroke: var(--star);
    stroke-width: 1;
    opacity: 0;
  }

  .pp-svg :global(.pp-bar) {
    fill: color-mix(in srgb, var(--c) 12%, transparent);
  }

  .pp-svg :global(.pp-cta) {
    fill: color-mix(in srgb, var(--brand) 3%, transparent);
    stroke: color-mix(in srgb, var(--brand) 40%, var(--sky-line));
  }

  .pp-svg :global(.pp-warp) {
    fill: none;
    stroke: color-mix(in srgb, var(--brand) 30%, transparent);
  }

  /* Entrances, only while the journey runs: each station draws itself in when it comes on */

  .pp[data-live="motion"] .pp-st.is-on :global(.pp-in) {
    animation: pp-fade 700ms var(--ease-out) var(--d, 0ms) both;
  }

  .pp[data-live="motion"] .pp-st.is-on :global(.pp-glyph.pp-in) {
    transform-box: fill-box;
    transform-origin: center;
    animation: pp-pop 600ms var(--ease-out) var(--d, 0ms) both;
  }

  .pp[data-live="motion"] .pp-st.is-on :global(.pp-draw) {
    stroke-dasharray: 1 1;
    animation: pp-draw 900ms var(--ease-out) var(--d, 0ms) both;
  }

  .pp[data-live="motion"] .pp-st.is-on :global(.pp-cursor) {
    animation: pp-sweep 4600ms linear var(--d, 0ms) both;
  }

  .pp[data-live="motion"] .pp-st.is-on :global(.pp-barrier.is-kept:not(.is-static)) {
    animation: pp-kept 900ms var(--ease-out) var(--d, 0ms) both;
  }

  .pp[data-live="motion"] .pp-st.is-on :global(.pp-barrier.is-elided:not(.is-static)) {
    animation: pp-elided 1100ms var(--ease-out) var(--d, 0ms) both;
  }

  .pp[data-live="motion"] .pp-st.is-on :global(.pp-buf) {
    animation: pp-drop 700ms var(--ease-out) var(--d, 0ms) both;
  }

  .pp[data-live="motion"] .pp-st.is-on :global(.pp-buf.is-retiring) {
    animation:
      pp-drop 700ms var(--ease-out) var(--d, 0ms) both,
      pp-retire 600ms var(--ease-out) var(--l, 0ms) both;
  }

  .pp[data-live="motion"] .pp-st.is-on :global(.pp-buf-label) {
    animation: pp-fade 500ms var(--ease-out) var(--d, 0ms) both;
  }

  .pp[data-live="motion"] .pp-st.is-on :global(.pp-buf-label.is-retiring) {
    animation:
      pp-fade 500ms var(--ease-out) var(--d, 0ms) both,
      pp-label-retire 600ms var(--ease-out) var(--l, 0ms) both;
  }

  .pp[data-live="motion"] .pp-st.is-on :global(.pp-grow) {
    transform-box: fill-box;
    transform-origin: left center;
    animation: pp-grow 900ms var(--ease-out) var(--d, 0ms) both;
  }

  .pp[data-live="motion"] .pp-st.is-on :global(.pp-warp) {
    animation:
      pp-fade 500ms var(--ease-out) var(--d, 0ms) both,
      pp-warp-light 900ms var(--ease-out) var(--l, 0ms) both;
  }

  @keyframes pp-fade {
    from {
      opacity: 0;
    }
  }

  @keyframes pp-pop {
    from {
      opacity: 0;
      transform: scale(0.2);
    }
  }

  @keyframes pp-draw {
    from {
      stroke-dashoffset: 1;
    }
    to {
      stroke-dashoffset: 0;
    }
  }

  @keyframes pp-sweep {
    0% {
      transform: translateX(0);
      opacity: 0;
    }
    4%,
    94% {
      opacity: 0.85;
    }
    100% {
      transform: translateX(var(--sweep));
      opacity: 0;
    }
  }

  @keyframes pp-kept {
    from {
      opacity: 0.12;
      stroke-width: 2;
    }
    30% {
      opacity: 1;
      stroke-width: 5;
    }
    to {
      opacity: 1;
      stroke-width: 2;
    }
  }

  @keyframes pp-elided {
    from {
      opacity: 0.12;
    }
    25% {
      opacity: 0.9;
    }
    to {
      opacity: 0.45;
    }
  }

  @keyframes pp-drop {
    from {
      opacity: 0;
      transform: translateY(-90px);
    }
  }

  @keyframes pp-retire {
    from {
      fill-opacity: 1;
      stroke-opacity: 1;
      stroke-dasharray: none;
    }
    to {
      fill-opacity: 0;
      stroke-opacity: 0.55;
      stroke-dasharray: 3 3;
    }
  }

  @keyframes pp-label-retire {
    from {
      opacity: 1;
    }
    to {
      opacity: 0.5;
    }
  }

  @keyframes pp-grow {
    from {
      transform: scaleX(0);
    }
  }

  @keyframes pp-warp-light {
    from {
      stroke: color-mix(in srgb, var(--brand) 8%, transparent);
    }
    30% {
      stroke: color-mix(in srgb, var(--brand) 70%, transparent);
    }
  }

  /* Captions: all in one cell, so the tallest sets the height and nothing shifts */

  .pp-caps {
    display: grid;
    margin-top: 1rem;
    max-width: 54rem;
  }

  .pp-cap {
    grid-area: 1 / 1;
    margin: 0;
    color: var(--dust);
    font-size: 0.9375rem;
    line-height: 1.55;
    opacity: 0;
    visibility: hidden;
    transition:
      opacity var(--dur-2) var(--ease-out),
      visibility 0s linear var(--dur-2);
  }

  .pp-cap.is-on {
    opacity: 1;
    visibility: visible;
    transition: opacity var(--dur-3) var(--ease-out);
  }

  .pp-cap strong {
    margin-right: 0.75rem;
    color: var(--star);
    font-family: var(--font-mono);
    font-size: 0.875rem;
    font-weight: 500;
  }

  .pp-sr {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  @media (prefers-reduced-motion: reduce) {
    .pp-st,
    .pp-cap {
      transition: none;
    }
  }
</style>
