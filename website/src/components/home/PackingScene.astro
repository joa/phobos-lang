---
// Scene 4: shared memory, packed, drawn from a trace at build time: each buffer as a lifetime interval
// (program order across, byte offset down) at the offset the planner chose, and each barrier at its
// place in program order, kept or elided. It uses the gemm kernel without @aligned: with @aligned the
// k loop goes to the GEMM lowering, whose four panel buffers all live across the whole loop, so
// nothing there shares bytes. Drawn once per layout; CSS shows the one that fits. No script.
import ChartPlate from "../figures/ChartPlate.astro"
import { traceEntry } from "../../lib/viz/catalog"
import { KernelModel } from "../../lib/viz/model"
import { packing, type PackingFrame } from "../../lib/viz/packing"

const TRACE = "gemm_fp32_no_aligned"
const entry = traceEntry(TRACE)
if (!entry) throw new Error(`PackingScene needs the ${TRACE} trace`)
const model = new KernelModel(entry.traces["sm_75"] ?? entry.traces[entry.chips[0]])
const aligned = traceEntry("gemm_fp32")?.traces["sm_75"]

interface Frame extends PackingFrame {
  widthUnits: number
  heightUnits: number
  charUnits: number
}

const FRAMES: Record<"wide" | "narrow", Frame> = {
  wide: { widthUnits: 1000, heightUnits: 330, left: 120, right: 970, top: 70, bottom: 262, charUnits: 7.3 },
  narrow: { widthUnits: 400, heightUnits: 380, left: 64, right: 386, top: 84, bottom: 292, charUnits: 7.3 },
}

const kept = model.barriers.filter(barrier => barrier.kept).length
const elided = model.barriers.length - kept
const label = "FIG / GEMM WITHOUT @ALIGNED / SHARED"
const layouts = (["wide", "narrow"] as const).map(layout => {
  const frame = FRAMES[layout]
  const packed = packing(model, frame)
  const fits = (text: string, width: number) => text.length * frame.charUnits + 10 <= width
  const buffers = packed.buffers.map(buffer => {
    const short = buffer.name.replace(/, remainder$/, "")
    const text = fits(buffer.name, buffer.width) ? buffer.name : fits(short, buffer.width) ? short : ""
    return { ...buffer, text }
  })
  return { layout, frame, buffers, barriers: packed.barriers, peakBytes: packed.peakBytes }
})
const desc =
  `${model.buffers.length} shared-memory buffers of the gemm kernel without @aligned, from its trace, drawn as intervals: across is program order, down is the byte offset, ${model.sharedPeakBytes} bytes at the peak. ` +
  `Buffers alive at the same time sit at different offsets; c_old reuses the bytes of the panels a and b once they have ended. ` +
  `Vertical lines mark the ${model.barriers.length} barriers: ${kept} kept, solid, and ${elided} elided, dashed.`
---

<section class="scene packing" id="shared-memory" aria-labelledby="packing-title">
  <div class="wrap">
    <div class="scene-head">
      <h2 class="scene-title" id="packing-title">Shared memory, packed</h2>
      <p class="scene-intro">
        Every tile a kernel stages lives in shared memory for part of its run. The planner gives each one an offset
        so that buffers alive at the same time never overlap and the rest share bytes, then drops every barrier that
        no longer separates a write from a read.
      </p>
    </div>
    {
      layouts.map(({ layout, frame, buffers, barriers, peakBytes }) => (
        <div class={`packing-plate is-${layout}`}>
          <ChartPlate
            id={`packing-${layout}`}
            widthUnits={frame.widthUnits}
            heightUnits={frame.heightUnits}
            label={label}
            title="Shared-memory buffers of a gemm kernel packed by lifetime"
            desc={desc}
          >
            <g class="sp-shared">
              <path class="chart-wire" d={`M${frame.left - 18} ${frame.top}V${frame.bottom}`} />
              <path class="chart-ticks" d={`M${frame.left - 24} ${frame.top}h12M${frame.left - 24} ${frame.bottom}h12`} />
              <text class="chart-label is-small" x={frame.left - 30} y={frame.top} text-anchor="end" dominant-baseline="middle">
                0
              </text>
              <text class="chart-label is-small" x={frame.left - 30} y={frame.bottom} text-anchor="end" dominant-baseline="middle">
                {layout === "wide" ? `${peakBytes} bytes` : `${peakBytes}`}
              </text>
              <text class="chart-label is-small" x={frame.left - 18} y={frame.top - 18} text-anchor="middle">
                bytes
              </text>
              {buffers.map(buffer => (
                <g>
                  <rect class="chart-box is-on" x={buffer.x} y={buffer.y + 1} width={buffer.width} height={buffer.height - 2} />
                  {buffer.text && (
                    <text
                      class="chart-label is-small is-on"
                      x={buffer.x + 5}
                      y={buffer.y + buffer.height / 2 + 0.5}
                      dominant-baseline="middle"
                    >
                      {buffer.text}
                    </text>
                  )}
                </g>
              ))}
            </g>
            {barriers.map(barrier => (
              <g>
                <path
                  class={barrier.kept ? "chart-wire is-on sp-reg" : "chart-wire packing-dash"}
                  d={`M${barrier.x} ${frame.top - 12}V${frame.bottom + 8}`}
                />
                <circle class={barrier.kept ? "chart-node is-on sp-reg" : "chart-node"} cx={barrier.x} cy={frame.top - 12} r="2" />
              </g>
            ))}
            <path class="chart-wire" d={`M${frame.left} ${frame.bottom + 30}H${frame.right}`} />
            <text class="chart-label is-small" x={frame.left} y={frame.bottom + 46} dominant-baseline="middle">
              {`barriers: ${kept} kept, solid; ${elided} elided, dashed`}
            </text>
            <text class="chart-label is-small" x={frame.right} y={frame.bottom + 64} text-anchor="end" dominant-baseline="middle">
              program order
            </text>
          </ChartPlate>
        </div>
      ))
    }
    <p class="packing-note">
      From the trace of <a href={`/viz/${TRACE}/`}><code>examples/gemm_fp32.ph</code> without <code>@aligned</code></a>{" "}
      on {model.chip}. With <code>@aligned</code> the k loop goes to the GEMM lowering instead, which stages its panels
      in {aligned?.buffers.length ?? 4} buffers that all live across the whole loop.
    </p>
  </div>
</section>

<style>
  .packing-plate.is-narrow {
    display: none;
  }

  .packing-plate :global(.packing-dash) {
    stroke: var(--dust);
    stroke-dasharray: 2 3;
  }

  .packing-note {
    max-width: 48rem;
    margin: 1rem 0 0;
    color: var(--dust);
    font-size: 0.875rem;
  }

  @media (max-width: 599px) {
    .packing-plate.is-wide {
      display: none;
    }

    .packing-plate.is-narrow {
      display: block;
    }
  }
</style>
