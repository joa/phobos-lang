---
// A shell command in a box with a copy button. Several forms of one command show as tabs: the release
// binary and the cargo command from a checkout, given as `release` and `checkout`, or any others as
// `tabs`. A choice holds for every box with the same `syncKey`, on every page: it is stored the way
// Starlight's synced <Tabs> store theirs, so a box and a <Tabs> with one key agree, and it is restored
// right after each box is parsed, so a box never flips once drawn.
interface Tab {
  label: string
  command: string
}

interface Props {
  release?: string
  checkout?: string
  tabs?: Tab[]
  syncKey?: string
  /** Names what the tabs choose between, for screen readers. */
  choice?: string
}

const { release, checkout } = Astro.props
const sourceTabs = [
  { label: "Release", command: release },
  { label: "Checkout", command: checkout },
].filter((tab): tab is Tab => tab.command !== undefined)
const tabs = Astro.props.tabs ?? sourceTabs
const syncKey = Astro.props.syncKey ?? (Astro.props.tabs ? undefined : "source")
const choice = Astro.props.choice ?? "Run from"
if (tabs.length === 0) throw new Error("Command needs a release, a checkout or tabs")

// Counted per page, so the tab and panel ids are unique on it and the same from build to build. The
// first synced box on a page also carries the restore function every synced box calls.
const countSymbol = Symbol.for("phobos:command-count")
const restoreSymbol = Symbol.for("phobos:command-restore")
const locals = Astro.locals as App.Locals & { [countSymbol]?: number; [restoreSymbol]?: boolean }
locals[countSymbol] ??= 0
const id = `command-${locals[countSymbol]++}`
const tabbed = tabs.length > 1
const synced = tabbed && syncKey !== undefined
const renderRestore = synced && !locals[restoreSymbol]
if (synced) locals[restoreSymbol] = true
---

{
  renderRestore && (
    <script is:inline>
      window.phobosCommandRestore = box => {
        let label = null
        try {
          label = localStorage.getItem("starlight-synced-tabs__" + box.dataset.syncKey)
        } catch {}
        const tabs = [...box.querySelectorAll("[role='tab']")]
        if (!label || !tabs.some(tab => tab.textContent.trim() === label)) return
        tabs.forEach(tab => {
          const selected = tab.textContent.trim() === label
          tab.setAttribute("aria-selected", String(selected))
          tab.tabIndex = selected ? 0 : -1
          document.getElementById(tab.getAttribute("aria-controls")).hidden = !selected
        })
      }
    </script>
  )
}
<phobos-command class="command not-content" data-sync-key={synced ? syncKey : undefined}>
  <div class="command-bar">
    {
      tabbed ? (
        <div class="command-tabs" role="tablist" aria-label={choice}>
          {tabs.map(({ label }, tabIndex) => (
            <button
              type="button"
              role="tab"
              id={`${id}-${tabIndex}-tab`}
              aria-controls={`${id}-${tabIndex}`}
              aria-selected={tabIndex === 0 ? "true" : "false"}
              tabindex={tabIndex === 0 ? 0 : -1}
            >
              {label}
            </button>
          ))}
        </div>
      ) : (
        <span class="command-label">{tabs[0].label}</span>
      )
    }
    <button type="button" class="command-copy" aria-label="Copy command">
      <svg viewBox="0 0 24 24" aria-hidden="true">
        <rect x="8" y="8" width="12" height="12" rx="1"></rect>
        <path d="M16 8V5a1 1 0 0 0-1-1H5a1 1 0 0 0-1 1v10a1 1 0 0 0 1 1h3"></path>
      </svg>
      <span class="command-copy-text" aria-live="polite">Copy</span>
    </button>
  </div>
  {
    tabs.map(({ command }, tabIndex) => (
      <pre
        id={`${id}-${tabIndex}`}
        role={tabbed ? "tabpanel" : undefined}
        aria-labelledby={tabbed ? `${id}-${tabIndex}-tab` : undefined}
        hidden={tabIndex > 0}
        tabindex="0"
      ><code>{command}</code></pre>
    ))
  }
</phobos-command>
{
  synced && (
    <script is:inline>window.phobosCommandRestore(document.currentScript.previousElementSibling)</script>
  )
}

<script>
  const copiedMillis = 2000

  function selectTab(box: HTMLElement, label: string) {
    box.querySelectorAll<HTMLButtonElement>("[role='tab']").forEach(tab => {
      const selected = tab.textContent?.trim() === label
      tab.setAttribute("aria-selected", String(selected))
      tab.tabIndex = selected ? 0 : -1
      const panel = document.getElementById(tab.getAttribute("aria-controls") ?? "")
      if (panel) panel.hidden = !selected
    })
  }

  function select(box: HTMLElement, label: string) {
    const syncKey = box.dataset.syncKey
    if (!syncKey) return selectTab(box, label)
    try {
      localStorage.setItem(`starlight-synced-tabs__${syncKey}`, label)
    } catch {}
    document.querySelectorAll<HTMLElement>("phobos-command").forEach(other => {
      if (other.dataset.syncKey === syncKey) selectTab(other, label)
    })
  }

  async function copyText(text: string): Promise<boolean> {
    try {
      await navigator.clipboard.writeText(text)
      return true
    } catch {
      return false
    }
  }

  class PhobosCommand extends HTMLElement {
    connectedCallback() {
      const tabs = [...this.querySelectorAll<HTMLButtonElement>("[role='tab']")]
      tabs.forEach((tab, index) => {
        tab.addEventListener("click", () => select(this, tab.textContent?.trim() ?? ""))
        tab.addEventListener("keydown", event => {
          const step = { ArrowRight: 1, ArrowLeft: -1 }[event.key]
          if (step === undefined) return
          event.preventDefault()
          const next = tabs[(index + step + tabs.length) % tabs.length]
          select(this, next.textContent?.trim() ?? "")
          next.focus()
        })
      })

      const copy = this.querySelector<HTMLButtonElement>(".command-copy")
      const status = this.querySelector(".command-copy-text")
      let resetTimer: number | undefined
      copy?.addEventListener("click", async () => {
        const panel = [...this.querySelectorAll<HTMLElement>("pre")].find(pre => !pre.hidden)
        const copied = await copyText(panel?.textContent ?? "")
        if (!status) return
        status.textContent = copied ? "Copied" : "Copy failed"
        window.clearTimeout(resetTimer)
        resetTimer = window.setTimeout(() => (status.textContent = "Copy"), copiedMillis)
      })
    }
  }
  if (!customElements.get("phobos-command")) customElements.define("phobos-command", PhobosCommand)
</script>

<style>
  .command {
    display: block;
    width: 100%;
    min-width: 0;
    border: 1px solid var(--sky-line);
    background: var(--sky-1);
  }

  .command-bar {
    display: flex;
    align-items: stretch;
    justify-content: space-between;
    gap: 0.5rem;
    border-bottom: 1px solid var(--sky-line);
    background: var(--sky-2);
    font-family: var(--font-sans);
    font-size: 0.8125rem;
  }

  .command-tabs {
    display: flex;
  }

  .command-tabs button,
  .command-label,
  .command-copy {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    margin: 0;
    padding: 0.375rem 0.875rem;
    border: 0;
    background: transparent;
    color: var(--dust);
    font: inherit;
    line-height: 1.4;
  }

  .command-tabs button,
  .command-copy {
    cursor: pointer;
    transition: color var(--dur-1) var(--ease-out);
  }

  .command-tabs button {
    box-shadow: inset 0 -2px 0 transparent;
  }

  .command-tabs button:hover,
  .command-copy:hover {
    color: var(--star);
  }

  .command-tabs button[aria-selected="true"] {
    color: var(--star);
    box-shadow: inset 0 -2px 0 var(--brand);
  }

  .command-tabs button:focus-visible,
  .command-copy:focus-visible,
  .command pre:focus-visible {
    outline: 2px solid var(--brand);
    outline-offset: -2px;
  }

  .command-copy svg {
    width: 0.875rem;
    height: 0.875rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.8;
    stroke-linejoin: round;
  }

  .command pre {
    margin: 0;
    padding: 0.875rem 1rem;
    overflow-x: auto;
    border: 0;
    background: transparent;
    color: var(--star);
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    line-height: 1.55;
    white-space: pre;
  }

  .command pre[hidden] {
    display: none;
  }

  .command pre code {
    padding: 0;
    border: 0;
    background: none;
    color: inherit;
    font: inherit;
  }
</style>
