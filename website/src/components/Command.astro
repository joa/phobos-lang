---
// A shell command in a box with a copy button. Given both forms, the release binary and the cargo
// command from a checkout, it shows them as two tabs. The choice is one preference for the whole site:
// HeadMeta restores it before first paint, and picking a tab in any box switches every box.
interface Props {
  release?: string
  checkout?: string
}

const { release, checkout } = Astro.props
const variants = [
  { source: "release", label: "Release", command: release },
  { source: "checkout", label: "Checkout", command: checkout },
].filter((variant): variant is { source: string; label: string; command: string } => variant.command !== undefined)
if (variants.length === 0) throw new Error("Command needs a release or a checkout command")

// Counted per page, so the tab and panel ids are unique on it and the same from build to build.
const countSymbol = Symbol.for("phobos:command-count")
const locals = Astro.locals as App.Locals & { [countSymbol]?: number }
locals[countSymbol] ??= 0
const id = `command-${locals[countSymbol]++}`
const tabbed = variants.length > 1
---

<phobos-command class="command not-content" data-tabbed={tabbed ? "" : undefined}>
  <div class="command-bar">
    {
      tabbed ? (
        <div class="command-tabs" role="tablist" aria-label="Run from">
          {variants.map(({ source, label }, index) => (
            <button
              type="button"
              role="tab"
              id={`${id}-${source}-tab`}
              aria-controls={`${id}-${source}`}
              aria-selected={index === 0 ? "true" : "false"}
              tabindex={index === 0 ? 0 : -1}
              data-source={source}
            >
              {label}
            </button>
          ))}
        </div>
      ) : (
        <span class="command-label">{variants[0].label}</span>
      )
    }
    <button type="button" class="command-copy" aria-label="Copy command">
      <svg viewBox="0 0 24 24" aria-hidden="true">
        <rect x="8" y="8" width="12" height="12" rx="1"></rect>
        <path d="M16 8V5a1 1 0 0 0-1-1H5a1 1 0 0 0-1 1v10a1 1 0 0 0 1 1h3"></path>
      </svg>
      <span class="command-copy-text" aria-live="polite">Copy</span>
    </button>
  </div>
  {
    variants.map(({ source, command }) => (
      <pre
        id={`${id}-${source}`}
        data-source={source}
        role={tabbed ? "tabpanel" : undefined}
        aria-labelledby={tabbed ? `${id}-${source}-tab` : undefined}
        tabindex="0"
      ><code>{command}</code></pre>
    ))
  }
</phobos-command>

<script>
  const storageKey = "phobos-command-source"
  const copiedMillis = 2000

  function currentSource(): string {
    return document.documentElement.dataset.commandSource ?? "release"
  }

  // Panels show by CSS from the root attribute, so this only keeps the tabs' state in step with it.
  function syncTabs() {
    const source = currentSource()
    document.querySelectorAll<HTMLButtonElement>("phobos-command [role='tab']").forEach(tab => {
      const selected = tab.dataset.source === source
      tab.setAttribute("aria-selected", String(selected))
      tab.tabIndex = selected ? 0 : -1
    })
  }

  function select(source: string) {
    document.documentElement.dataset.commandSource = source
    try {
      localStorage.setItem(storageKey, source)
    } catch {}
    syncTabs()
  }

  async function copyText(text: string): Promise<boolean> {
    try {
      await navigator.clipboard.writeText(text)
      return true
    } catch {
      return false
    }
  }

  class PhobosCommand extends HTMLElement {
    connectedCallback() {
      const tabs = [...this.querySelectorAll<HTMLButtonElement>("[role='tab']")]
      tabs.forEach((tab, index) => {
        tab.addEventListener("click", () => select(tab.dataset.source ?? "release"))
        tab.addEventListener("keydown", event => {
          const step = { ArrowRight: 1, ArrowLeft: -1 }[event.key]
          if (step === undefined) return
          event.preventDefault()
          const next = tabs[(index + step + tabs.length) % tabs.length]
          select(next.dataset.source ?? "release")
          next.focus()
        })
      })
      if (tabs.length > 0) syncTabs()

      const copy = this.querySelector<HTMLButtonElement>(".command-copy")
      const status = this.querySelector(".command-copy-text")
      let resetTimer: number | undefined
      copy?.addEventListener("click", async () => {
        const panels = [...this.querySelectorAll<HTMLElement>("pre")]
        const panel = panels.find(pre => pre.dataset.source === currentSource()) ?? panels[0]
        const copied = await copyText(panel?.textContent ?? "")
        if (!status) return
        status.textContent = copied ? "Copied" : "Copy failed"
        window.clearTimeout(resetTimer)
        resetTimer = window.setTimeout(() => (status.textContent = "Copy"), copiedMillis)
      })
    }
  }
  if (!customElements.get("phobos-command")) customElements.define("phobos-command", PhobosCommand)
</script>

<style>
  .command {
    display: block;
    width: 100%;
    min-width: 0;
    border: 1px solid var(--sky-line);
    background: var(--sky-1);
  }

  .command-bar {
    display: flex;
    align-items: stretch;
    justify-content: space-between;
    gap: 0.5rem;
    border-bottom: 1px solid var(--sky-line);
    background: var(--sky-2);
    font-family: var(--font-sans);
    font-size: 0.8125rem;
  }

  .command-tabs {
    display: flex;
  }

  .command-tabs button,
  .command-label,
  .command-copy {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    margin: 0;
    padding: 0.375rem 0.875rem;
    border: 0;
    background: transparent;
    color: var(--dust);
    font: inherit;
    line-height: 1.4;
  }

  .command-tabs button,
  .command-copy {
    cursor: pointer;
    transition: color var(--dur-1) var(--ease-out);
  }

  .command-tabs button {
    box-shadow: inset 0 -2px 0 transparent;
  }

  .command-tabs button:hover,
  .command-copy:hover {
    color: var(--star);
  }

  .command-tabs button[data-source="release"],
  :root[data-command-source="checkout"] .command-tabs button[data-source="checkout"] {
    color: var(--star);
    box-shadow: inset 0 -2px 0 var(--brand);
  }

  :root[data-command-source="checkout"] .command-tabs button[data-source="release"] {
    color: var(--dust);
    box-shadow: inset 0 -2px 0 transparent;
  }

  .command-tabs button:focus-visible,
  .command-copy:focus-visible,
  .command pre:focus-visible {
    outline: 2px solid var(--brand);
    outline-offset: -2px;
  }

  .command-copy svg {
    width: 0.875rem;
    height: 0.875rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.8;
    stroke-linejoin: round;
  }

  .command pre {
    margin: 0;
    padding: 0.875rem 1rem;
    overflow-x: auto;
    border: 0;
    background: transparent;
    color: var(--star);
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    line-height: 1.55;
    white-space: pre;
  }

  .command pre code {
    padding: 0;
    border: 0;
    background: none;
    color: inherit;
    font: inherit;
  }

  .command[data-tabbed] pre[data-source="checkout"],
  :root[data-command-source="checkout"] .command[data-tabbed] pre[data-source="release"] {
    display: none;
  }

  :root[data-command-source="checkout"] .command[data-tabbed] pre[data-source="checkout"] {
    display: block;
  }
</style>
