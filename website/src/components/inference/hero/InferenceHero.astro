---
// The sky behind /inference/'s hero, kin to the front page's: three depths of stars, the limb of Mars,
// and in place of the moon a stack of layers that tokens stream through, one decode step at a time,
// and come back round the orbit as words. Starlight draws the hero's text from the page's frontmatter;
// this component sits behind it and restyles it. The build draws the opening frame as SVG, which is
// all a page without script or with reduced motion shows; once the page is idle a canvas takes over
// from the same moment and keeps going.
import { makeStarfield, SKY_HEIGHT_UNITS, SKY_WIDTH_UNITS, type Star } from "../../home/starfield"
import { inkCss } from "../../home/hero/static-frame"
import { LABEL_OFFSET_UNITS, LABEL_UNITS, staticFrame } from "./static-frame"
import { VIEW_UNITS } from "./model"

// Its own sky, from its own seed.
const { far, middle, near, twinkling } = makeStarfield(0x1af3e2)
const viewBox = `0 0 ${SKY_WIDTH_UNITS} ${SKY_HEIGHT_UNITS}`
const tintClass = (star: Star) => (star.tint ? `t-${star.tint}` : undefined)
const frame = staticFrame()
const sceneViewBox = `0 0 ${VIEW_UNITS} ${VIEW_UNITS}`
---

<div class="inf-sky not-content" aria-hidden="true">
  <div class="layer layer-far" data-depth="5">
    <svg class="stars stars-far" viewBox={viewBox} preserveAspectRatio="xMidYMid slice">
      {far.map(star => <circle class={tintClass(star)} cx={star.x} cy={star.y} r={star.radiusUnits} fill-opacity={star.opacity} />)}
    </svg>
  </div>
  <div class="layer layer-middle" data-depth="12">
    <svg class="stars stars-middle" viewBox={viewBox} preserveAspectRatio="xMidYMid slice">
      {middle.map(star => <circle class={tintClass(star)} cx={star.x} cy={star.y} r={star.radiusUnits} fill-opacity={star.opacity} />)}
      {
        twinkling.map(star => (
          <circle
            class:list={["tw", tintClass(star)]}
            cx={star.x}
            cy={star.y}
            r={star.radiusUnits}
            fill-opacity={star.opacity}
            style={`animation-delay: ${star.delayMs}ms; animation-duration: ${star.periodMs}ms`}
          />
        ))
      }
    </svg>
  </div>
  <div class="layer layer-near" data-depth="26">
    <svg class="stars stars-near" viewBox={viewBox} preserveAspectRatio="xMidYMid slice">
      {near.map(star => <circle class={tintClass(star)} cx={star.x} cy={star.y} r={star.radiusUnits} fill-opacity={star.opacity} />)}
    </svg>
  </div>
  <div class="limb"></div>

  <div class="inf-scene">
    <svg class="inf-scene-static" viewBox={sceneViewBox}>
      <defs>
        <radialGradient id="inf-head-glow">
          <stop offset="0" class="glow-core"></stop>
          <stop offset="1" class="glow-edge"></stop>
        </radialGradient>
      </defs>
      {
        frame.heads.map(head => (
          <circle cx={head.x.toFixed(1)} cy={head.y.toFixed(1)} r={(18 + 30 * head.heat).toFixed(1)} fill="url(#inf-head-glow)" opacity={head.heat.toFixed(2)} />
        ))
      }
      <g class="points">
        {frame.paths.map(path => <path d={path.d} stroke-width={path.widthUnits} style={`stroke: ${inkCss(path.ink)}; --a: ${path.ink.alpha}`} />)}
      </g>
      {
        frame.labels.map(label => (
          <text
            x={(label.x + LABEL_OFFSET_UNITS.x).toFixed(1)}
            y={(label.y + LABEL_OFFSET_UNITS.y).toFixed(1)}
            font-size={LABEL_UNITS}
            style={`--a: ${label.alpha}`}>
            {label.text}
          </text>
        ))
      }
    </svg>
    <canvas class="inf-scene-canvas"></canvas>
  </div>
</div>

<script>
  // The scene's code is its own chunk, fetched once the page has loaded and gone idle.
  const root = document.querySelector<HTMLElement>(".inf-sky")
  if (root) {
    const boot = () => {
      import("./scene").then(module => module.start(root)).catch(() => {})
    }
    const idle = () => {
      if ("requestIdleCallback" in window) requestIdleCallback(boot, { timeout: 2000 })
      else setTimeout(boot, 300)
    }
    if (document.readyState === "complete") idle()
    else window.addEventListener("load", idle, { once: true })
  }
</script>

<style>
  /* The hero's height, shared by Starlight's hero (the text) and the sky behind it */
  :global(.content-panel:has(.inf-sky)) {
    --inf-hero-h: max(34rem, min(calc(100svh - var(--sl-nav-height)), 64rem));
    --inf-scene-size: clamp(540px, 54vw, 1000px);
    --inf-scene-x: calc(50% + min(29rem, 24vw));
    --scene-halo: color-mix(in srgb, var(--brand) 16%, transparent);
    --headline-glow: color-mix(in srgb, var(--brand) 26%, transparent);
    --limb-scatter: color-mix(in srgb, var(--brand) 14%, transparent);
    position: relative;
    isolation: isolate;
  }

  :global(:root[data-theme="light"] .content-panel:has(.inf-sky)) {
    --scene-halo: color-mix(in srgb, var(--brand) 9%, transparent);
    --headline-glow: color-mix(in srgb, var(--brand) 10%, transparent);
    --limb-scatter: color-mix(in srgb, var(--brand) 7%, transparent);
  }

  /* The sky spans the panel, which spans the page on a splash page, from the top to the hero's foot */
  .inf-sky {
    position: absolute;
    inset: 0 0 auto;
    z-index: -1;
    height: var(--inf-hero-h);
    margin: 0;
    overflow: hidden;
    pointer-events: none;
    /* The limb fades into the page instead of ending at the hero's edge */
    mask-image: linear-gradient(to bottom, #000 74%, transparent);
  }

  /* A cold glow where the stack stands, and a warm one above the limb */
  .inf-sky::before,
  .inf-sky::after {
    content: "";
    position: absolute;
    pointer-events: none;
  }

  .inf-sky::before {
    inset: 0;
    background: radial-gradient(42% 52% at var(--inf-scene-x) 46%, var(--scene-halo), transparent 70%);
  }

  .inf-sky::after {
    inset: auto 0 0;
    height: 45%;
    background: radial-gradient(120% 100% at 50% 100%, color-mix(in srgb, var(--limb-rim) 24%, transparent), transparent 70%);
  }

  /* Each star layer drifts on its own slow loop and follows the pointer by its depth (the scene script
   * sets the layer's transform); the far layer moves least. */
  .layer {
    position: absolute;
    inset: -3%;
    will-change: transform;
  }

  .stars {
    position: absolute;
    inset: -10% 0 0;
    width: 100%;
    height: 110%;
    fill: var(--starfield);
    opacity: var(--starfield-opacity);
    animation: sky-drift var(--drift-period, 160s) ease-in-out infinite;
  }

  .stars .t-b {
    fill: var(--brand);
  }

  .stars .t-n {
    fill: var(--nebula);
  }

  .stars-far {
    --drift-x: 6px;
    --drift-y: 3px;
    --drift-period: 190s;
    opacity: calc(var(--starfield-opacity) * 0.8);
  }

  .stars-middle {
    --drift-x: 14px;
    --drift-y: 6px;
    --drift-period: 150s;
  }

  .stars-near {
    --drift-x: 30px;
    --drift-y: 12px;
    --drift-period: 120s;
  }

  /* A closed loop, so the drift never jumps */
  @keyframes sky-drift {
    0%,
    100% {
      transform: translate3d(0, 0, 0);
    }
    25% {
      transform: translate3d(var(--drift-x), calc(var(--drift-y) * -1), 0);
    }
    50% {
      transform: translate3d(0, calc(var(--drift-y) * -2), 0);
    }
    75% {
      transform: translate3d(calc(var(--drift-x) * -1), calc(var(--drift-y) * -1), 0);
    }
  }

  .tw {
    animation: twinkle 5s ease-in-out infinite alternate;
  }

  @keyframes twinkle {
    0%,
    40% {
      opacity: 1;
    }
    100% {
      opacity: 0.2;
    }
  }

  /* Mars: a lit disc with depth, a thin bright rim of atmosphere, and a scattering haze that breathes */
  .limb {
    position: absolute;
    left: 50%;
    top: calc(100% - 9svh - 4vw);
    width: 240vw;
    aspect-ratio: 1;
    translate: -50% 0;
    border-radius: 50%;
    background:
      radial-gradient(52% 6% at 50% 0%, color-mix(in srgb, var(--limb-rim) 70%, transparent), transparent),
      linear-gradient(180deg, color-mix(in srgb, var(--limb-rim) 55%, var(--limb)) 0, var(--limb) 11vh);
    box-shadow:
      0 0 0 1px color-mix(in srgb, var(--limb-rim) 85%, transparent),
      inset 0 10px 24px -12px color-mix(in srgb, var(--limb-rim) 90%, transparent),
      0 -2px 26px -4px color-mix(in srgb, var(--limb-rim) 55%, transparent);
  }

  .limb::before,
  .limb::after {
    content: "";
    position: absolute;
    border-radius: 50%;
    pointer-events: none;
  }

  .limb::before {
    inset: -1.6vw;
    background: radial-gradient(closest-side, transparent 97.4%, color-mix(in srgb, var(--limb-rim) 32%, transparent) 98.8%, transparent);
    animation: breathe 9s ease-in-out infinite alternate;
  }

  .limb::after {
    inset: -3.2vw;
    background: radial-gradient(closest-side, transparent 96.8%, var(--limb-scatter) 98.4%, transparent);
    animation: breathe 13s ease-in-out -4s infinite alternate;
  }

  @keyframes breathe {
    from {
      opacity: 0.55;
    }
    to {
      opacity: 1;
    }
  }

  /* The scene's box is square; the canvas and the build-time frame both fill it */
  .inf-scene {
    position: absolute;
    top: 50%;
    left: var(--inf-scene-x);
    width: var(--inf-scene-size);
    aspect-ratio: 1;
    translate: -50% -50%;
  }

  .inf-scene-static,
  .inf-scene-canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .inf-scene-static {
    transition: opacity 1.4s var(--ease-out);
  }

  .points path {
    fill: none;
    stroke-linecap: round;
    stroke-opacity: var(--a);
  }

  .inf-scene-static text {
    fill: var(--brand-hi);
    fill-opacity: calc(var(--a) * 0.85);
    font-family: var(--font-mono);
    font-weight: 500;
    dominant-baseline: middle;
  }

  .glow-core {
    stop-color: var(--brand-hi);
    stop-opacity: 0.3;
  }

  .glow-edge {
    stop-color: var(--brand-hi);
    stop-opacity: 0;
  }

  /* At dawn the dots are ink on a pale sky: the faintest are lifted, as the canvas does, and the glow
   * is a whisper */
  :global(:root[data-theme="light"]) .points path {
    stroke-opacity: min(1, calc(var(--a) * 0.85 + 0.08));
  }

  :global(:root[data-theme="light"]) .inf-scene-static text {
    fill: var(--brand);
  }

  :global(:root[data-theme="light"]) .glow-core {
    stop-opacity: 0.1;
  }

  .inf-scene-canvas {
    opacity: 0;
    transition: opacity 1.4s var(--ease-out);
  }

  .inf-sky[data-live] .inf-scene-canvas {
    opacity: 1;
  }

  .inf-sky[data-live] .inf-scene-static {
    opacity: 0;
  }

  /* Starlight's hero, from the page's frontmatter, over the sky */
  :global(.content-panel:has(.inf-sky) .hero) {
    position: relative;
    /* At middle widths the copy stays left of the orbit */
    grid-template-columns: minmax(0, min(40rem, 54%));
    align-content: center;
    min-height: calc(var(--inf-hero-h) - 1.5rem);
    padding-block: clamp(3rem, 10vh, 7rem) clamp(7rem, 20vh, 11rem);
  }

  :global(.content-panel:has(.inf-sky) .hero h1) {
    font-size: clamp(2.375rem, 5.2vw, 4.25rem);
    font-weight: 500;
    line-height: 1.04;
    letter-spacing: -0.032em;
    filter: drop-shadow(0 0 28px var(--headline-glow));
    animation: inf-rise 900ms var(--ease-out) both;
  }

  /* Star white into the brand's blue; an inline box, so the gradient runs along the reading order */
  :global(.content-panel:has(.inf-sky) .hero h1 .headline) {
    background: linear-gradient(
      90deg,
      var(--star) 0%,
      var(--star) 38%,
      color-mix(in srgb, var(--brand-hi) 80%, var(--star)) 70%,
      var(--brand) 100%
    );
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    animation: inf-uncover 1400ms var(--ease-out) both;
  }

  :global(.content-panel:has(.inf-sky) .hero .tagline) {
    max-width: 34rem;
    color: var(--dust);
    font-size: clamp(1.0625rem, 1.6vw, 1.25rem);
    line-height: 1.5;
    animation: inf-rise 900ms var(--ease-out) 160ms both;
  }

  :global(.content-panel:has(.inf-sky) .hero .actions) {
    gap: 0.75rem;
    margin-top: 0.75rem;
  }

  /* Starlight's link buttons in the site's button style */
  :global(.content-panel:has(.inf-sky) .hero .sl-link-button) {
    --button-bg: color-mix(in srgb, var(--sky-2) 62%, transparent);
    --button-rim: linear-gradient(
      135deg,
      color-mix(in srgb, var(--brand) 60%, var(--sky-line)),
      var(--sky-line) 45%,
      color-mix(in srgb, var(--nebula) 50%, var(--sky-line))
    );
    gap: 0.5rem;
    min-height: 2.75rem;
    padding: 0 1.25rem;
    border: 1px solid transparent;
    border-radius: 12px;
    background:
      linear-gradient(var(--button-bg), var(--button-bg)) padding-box,
      var(--button-rim) border-box;
    box-shadow:
      inset 0 1px 0 color-mix(in srgb, var(--star) 8%, transparent),
      0 8px 24px -16px var(--glow);
    backdrop-filter: blur(8px);
    color: var(--star);
    font-size: 0.9375rem;
    font-weight: 500;
    line-height: 1;
    text-decoration: none;
    transition:
      box-shadow var(--dur-2) var(--ease-out),
      transform var(--dur-2) var(--ease-out),
      color var(--dur-1) var(--ease-out);
    animation: inf-rise 800ms var(--ease-out) both;
  }

  :global(.content-panel:has(.inf-sky) .hero .sl-link-button:nth-child(1)) {
    animation-delay: 300ms;
  }

  :global(.content-panel:has(.inf-sky) .hero .sl-link-button:nth-child(2)) {
    animation-delay: 360ms;
  }

  :global(.content-panel:has(.inf-sky) .hero .sl-link-button:hover) {
    --button-bg: color-mix(in srgb, var(--brand) 12%, var(--sky-2));
    color: var(--star);
    box-shadow:
      inset 0 1px 0 color-mix(in srgb, var(--star) 12%, transparent),
      0 10px 30px -14px var(--glow);
    transform: translateY(-1px);
  }

  :global(.content-panel:has(.inf-sky) .hero .sl-link-button.primary) {
    --button-rim: linear-gradient(135deg, var(--brand-hi), var(--nebula));
    background:
      linear-gradient(135deg, var(--brand), color-mix(in srgb, var(--brand) 72%, var(--nebula))) padding-box,
      var(--button-rim) border-box;
    color: var(--sky-0);
    font-weight: 600;
    box-shadow:
      inset 0 1px 0 color-mix(in srgb, white 35%, transparent),
      0 10px 30px -12px color-mix(in srgb, var(--brand) 70%, transparent);
  }

  :global(.content-panel:has(.inf-sky) .hero .sl-link-button.primary:hover) {
    background:
      linear-gradient(135deg, var(--brand-hi), color-mix(in srgb, var(--brand-hi) 72%, var(--nebula))) padding-box,
      var(--button-rim) border-box;
    color: var(--sky-0);
    box-shadow:
      inset 0 1px 0 color-mix(in srgb, white 45%, transparent),
      0 12px 36px -10px color-mix(in srgb, var(--brand) 80%, transparent);
  }

  :global(.content-panel:has(.inf-sky) .hero .sl-link-button:active) {
    transform: translateY(0);
  }

  @keyframes inf-rise {
    from {
      opacity: 0;
      translate: 0 14px;
    }
  }

  @keyframes inf-uncover {
    from {
      mask-image: linear-gradient(90deg, #000 40%, transparent 60%);
      mask-size: 250% 100%;
      mask-position: 100% 0;
    }
    to {
      mask-image: linear-gradient(90deg, #000 40%, transparent 60%);
      mask-size: 250% 100%;
      mask-position: 0 0;
    }
  }

  /* Narrow screens: the stack stands above the headline, the copy sits low and reads from the left */
  @media (max-width: 50rem) {
    :global(.content-panel:has(.inf-sky)) {
      --inf-scene-size: min(112vw, 560px);
      --inf-scene-x: 50%;
    }

    .inf-scene {
      top: 0;
      translate: -50% 8%;
    }

    .inf-sky::before {
      background: radial-gradient(80% 40% at 50% 26%, var(--scene-halo), transparent 70%);
    }

    :global(.content-panel:has(.inf-sky) .hero) {
      grid-template-columns: minmax(0, 1fr);
      align-content: end;
      padding-block: calc(var(--inf-scene-size) * 0.74) clamp(5rem, 13vh, 8rem);
    }

    :global(.content-panel:has(.inf-sky) .hero .stack) {
      text-align: start;
    }

    :global(.content-panel:has(.inf-sky) .hero .copy) {
      align-items: flex-start;
    }

    :global(.content-panel:has(.inf-sky) .hero .actions) {
      justify-content: flex-start;
    }
  }

  /* Scroll parallax: the far stars sink faster than the near ones as the page scrolls */
  @supports (animation-timeline: scroll()) {
    .layer {
      animation: sink linear both;
      animation-timeline: scroll(root);
      animation-range: 0 100vh;
    }

    .layer-far {
      --sink: 16vh;
    }

    .layer-middle {
      --sink: 10vh;
    }

    .layer-near {
      --sink: 5vh;
    }

    @keyframes sink {
      to {
        translate: 0 var(--sink);
      }
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .stars,
    .tw,
    .layer,
    .limb::before,
    .limb::after {
      animation: none;
    }

    .inf-scene-static,
    .inf-scene-canvas {
      transition: none;
    }

    :global(.content-panel:has(.inf-sky) .hero h1),
    :global(.content-panel:has(.inf-sky) .hero h1 .headline),
    :global(.content-panel:has(.inf-sky) .hero .tagline),
    :global(.content-panel:has(.inf-sky) .hero .sl-link-button) {
      animation: none;
    }

    :global(.content-panel:has(.inf-sky) .hero .sl-link-button:hover) {
      transform: none;
    }
  }
</style>
